{%- style -%}
  .ks-proof-toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    max-width: 340px;
    background: #ffffff;
    border: 1px solid rgba(19, 78, 50, 0.15);
    border-radius: 16px;
    padding: 14px 16px;
    box-shadow: 0 15px 35px -5px rgba(8, 40, 26, 0.18), 0 5px 15px rgba(0,0,0,0.05);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
    pointer-events: none;
  }

  .ks-proof-toast.is-active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .ks-proof-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #134e32 0%, #08281a 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #fbbf24;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(19, 78, 50, 0.3);
  }

  .ks-proof-content {
    flex-grow: 1;
    font-size: 0.82rem;
    line-height: 1.4;
    color: #1f2937;
  }

  .ks-proof-content strong {
    color: #08281a;
    font-weight: 800;
    display: block;
    margin-bottom: 2px;
  }

  .ks-proof-time {
    font-size: 0.7rem;
    color: #10b981;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .ks-proof-close {
    position: absolute;
    top: 8px;
    right: 8px;
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    font-size: 14px;
    padding: 2px;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .ks-proof-close:hover {
    color: #1f2937;
  }
{%- endstyle -%}

<div id="ks-district-social-proof" class="ks-proof-toast" x-data="ksSocialProof()" x-init="initProof()">
  <button @click="dismissToast()" class="ks-proof-close" aria-label="Close">✕</button>
  
  <div class="ks-proof-icon" x-text="currentNotification.emoji">
    🌱
  </div>
  
  <div class="ks-proof-content">
    <strong x-text="currentNotification.name + ' (' + currentNotification.district + ')'"></strong>
    <span x-text="'ऑर्डर किया: ' + currentNotification.product"></span>
    <div class="ks-proof-time">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
      <span x-text="currentNotification.timeAgo"></span>
    </div>
  </div>
</div>

<script>
  function ksSocialProof() {
    return {
      notifications: [
        { emoji: '🌾', name: 'राजेश कुमार सिंह', district: 'पटना', product: 'Hybrid Paddy Seed 105 (5kg)', timeAgo: '12 मिनट पहले' },
        { emoji: '🧪', name: 'अमित यादव', district: 'समस्तीपुर', product: 'Bio-Shield Micronutrient Tonic', timeAgo: '18 मिनट पहले' },
        { emoji: '🛡️', name: 'सुनील शर्मा', district: 'मुजफ्फरपुर', product: 'TermiKiller Bio-Insecticide', timeAgo: '25 मिनट पहले' },
        { emoji: '🥦', name: 'रामेश्वर महतो', district: 'गया', product: 'Hybrid Vegetable Seed Combo', timeAgo: '7 मिनट पहले' },
        { emoji: '⚙️', name: 'संतोष कुमार', district: 'बेगूसराय', product: 'Battery Knapsack Sprayer', timeAgo: '31 मिनट पहले' }
      ],
      currentIndex: 0,
      currentNotification: {},
      isVisible: false,
      timer: null,

      initProof() {
        this.currentNotification = this.notifications[0];
        
        // Start the rotation loop after 4 seconds
        setTimeout(() => {
          this.showToast();
        }, 4000);
      },

      showToast() {
        const toast = document.getElementById('ks-district-social-proof');
        if (!toast) return;

        toast.classList.add('is-active');

        // Hide after 5 seconds
        setTimeout(() => {
          toast.classList.remove('is-active');
          
          // Schedule next popup after 8 seconds
          setTimeout(() => {
            this.currentIndex = (this.currentIndex + 1) % this.notifications.length;
            this.currentNotification = this.notifications[this.currentIndex];
            this.showToast();
          }, 8000);

        }, 5000);
      },

      dismissToast() {
        const toast = document.getElementById('ks-district-social-proof');
        if (toast) toast.classList.remove('is-active');
      }
    }
  }
</script>

{% schema %}
{
  "name": "Local",
  "tag": "section",
  "class": "section-local-social-proof",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays floating live purchase notifications from farmers across Bihar districts to boost buyer trust and conversions."
    }
  ],
  "presets": [
    {
      "name": "Local District Social Proof"
    }
  ]
}
{% endschema %}