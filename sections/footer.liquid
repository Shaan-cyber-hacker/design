{%- style -%}.ks-footer-{{ section.id }} {--ks-foot-bg: {{ section.settings.bg_color }};--ks-foot-bg-bottom: {{ section.settings.bg_bottom_color }};--ks-foot-text-main: {{ section.settings.heading_color }};--ks-foot-text-muted: {{ section.settings.text_color }};--ks-foot-accent: {{ section.settings.accent_color }};--ks-foot-border: rgba(255, 255, 255, 0.08);--ks-foot-emerald: #10b981;--ks-foot-emerald-glow: rgba(16, 185, 129, 0.15);font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
background: var(--ks-foot-bg);
color: var(--ks-foot-text-muted);
position: relative;
overflow: hidden;
margin-top: {{ section.settings.margin_top }}px;
}/* Responsive Padding */.ks-foot-inner-{{ section.id }} {padding-top: {{ section.settings.padding_top | divided_by: 1.5 | round }}px;padding-bottom: {{ section.settings.padding_bottom | divided_by: 1.5 | round }}px;}@media (min-width: 768px) {.ks-foot-inner-{{ section.id }} {padding-top: {{ section.settings.padding_top }}px;padding-bottom: {{ section.settings.padding_bottom }}px;}}/* Decorative Top Wave */.ks-footer-wave {position: absolute;top: 0;left: 0;width: 100%;overflow: hidden;line-height: 0;transform: translateY(-1px);z-index: 1;}.ks-footer-wave svg {display: block;width: calc(100% + 1.3px);height: 40px;}@media (min-width: 768px) {.ks-footer-wave svg { height: 60px; }}/* Animated Background Glow Decor */.ks-footer-{{ section.id }}::before {content: '';position: absolute;top: -100px;right: -100px;width: 500px;height: 500px;background: radial-gradient(circle, var(--ks-foot-emerald-glow) 0%, rgba(255,255,255,0) 70%);border-radius: 50%;pointer-events: none;z-index: 0;animation: ksFootPulse 6s ease-in-out infinite alternate;}@keyframes ksFootPulse {0% { transform: scale(1); opacity: 0.6; }100% { transform: scale(1.2); opacity: 1; }}.ks-footer-container {max-width: 1280px;margin: 0 auto;padding: 0 20px;position: relative;z-index: 2;}/* Smart Grid Layout */.ks-foot-grid {display: grid;grid-template-columns: 1fr;gap: 48px;}@media (min-width: 640px) {.ks-foot-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }}@media (min-width: 1024px) {.ks-foot-grid {grid-template-columns: 1.6fr repeat({{ section.blocks.size | minus: 1 | at_most: 3 }}, 1fr);gap: 56px;}}/* Column Titles /
.ks-foot-col-title {
font-size: 1.15rem;
font-weight: 800;
color: var(--ks-foot-text-main);
margin: 0 0 24px 0;
position: relative;
padding-bottom: 12px;
letter-spacing: 0.02em;
}
.ks-foot-col-title::after {
content: '';
position: absolute;
left: 0;
bottom: 0;
width: 35px;
height: 3px;
background: var(--ks-foot-accent);
border-radius: 4px;
transition: width 0.3s ease;
}
.ks-foot-col:hover .ks-foot-col-title::after {
width: 55px; / Interactive underline expansion */}/* 1. Brand Block Styling */.ks-foot-brand { display: flex; flex-direction: column; gap: 20px; }.ks-foot-logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; transition: transform 0.3s ease; }.ks-foot-logo:hover { transform: translateY(-2px); }.ks-foot-logo-icon {width: 48px; height: 48px;background: linear-gradient(135deg, var(--ks-foot-emerald), #047857);border-radius: 14px; display: flex; align-items: center; justify-content: center;font-size: 24px; box-shadow: 0 8px 16px rgba(4, 120, 87, 0.3);}.ks-foot-logo-text { font-size: 28px; font-weight: 900; color: var(--ks-foot-text-main); letter-spacing: -0.03em; }.ks-foot-logo-text span { color: var(--ks-foot-accent); }.ks-foot-desc { font-size: 0.95rem; line-height: 1.7; margin: 0; color: var(--ks-foot-text-muted); }.ks-foot-contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }.ks-foot-contact-item { display: flex; align-items: flex-start; gap: 14px; font-size: 0.9rem; line-height: 1.5; transition: transform 0.3s ease; }.ks-foot-contact-item:hover { transform: translateX(4px); }.ks-foot-contact-item svg { width: 22px; height: 22px; color: var(--ks-foot-accent); margin-top: 2px; flex-shrink: 0; }/* 2. Menu Links - Interactive */.ks-foot-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }.ks-foot-links a {color: var(--ks-foot-text-muted); text-decoration: none; font-size: 0.95rem;font-weight: 500; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px;}.ks-foot-links a::before {content: '→'; font-size: 0.9rem; color: var(--ks-foot-emerald);opacity: 0; transform: translateX(-10px); transition: all 0.3s ease;}.ks-foot-links a:hover { color: var(--ks-foot-accent); transform: translateX(4px); }.ks-foot-links a:hover::before { opacity: 1; transform: translateX(0); }/* 3. Decorative Trust Badges Block */.ks-trust-badges { display: flex; flex-direction: column; gap: 14px; }.ks-trust-badge-item {display: flex; align-items: center; gap: 14px; background: rgba(255,255,255,0.03);padding: 12px 14px; border-radius: 14px; border: 1px solid var(--ks-foot-border);transition: all 0.3s ease; cursor: default;}.ks-trust-badge-item:hover {background: rgba(255,255,255,0.06);border-color: var(--ks-foot-emerald);transform: translateY(-3px);box-shadow: 0 10px 20px rgba(0,0,0,0.1);}.ks-trust-icon {width: 42px; height: 42px; border-radius: 12px; background: var(--ks-foot-emerald-glow);color: var(--ks-foot-emerald); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s ease;}.ks-trust-badge-item:hover .ks-trust-icon { background: var(--ks-foot-emerald); color: #fff; }.ks-trust-text strong { display: block; color: var(--ks-foot-text-main); font-size: 0.95rem; font-weight: 700; }.ks-trust-text span { font-size: 0.8rem; color: var(--ks-foot-text-muted); display: block; margin-top: 2px;}/* 4. Newsletter & Social */.ks-newsletter-form { display: flex; position: relative; margin-top: 18px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); border-radius: 12px;}.ks-newsletter-input {width: 100%; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--ks-foot-border);padding: 15px 16px; border-radius: 12px; color: white; font-size: 0.95rem; outline: none; transition: all 0.3s ease;}.ks-newsletter-input:focus { border-color: var(--ks-foot-accent); background: rgba(255, 255, 255, 0.08); box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.1); }.ks-newsletter-btn {position: absolute; right: 5px; top: 5px; bottom: 5px; background: var(--ks-foot-accent);color: #000; border: none; border-radius: 9px; padding: 0 22px; font-weight: 800; cursor: pointer; transition: all 0.3s ease;}.ks-newsletter-btn:hover { background: #f59e0b; transform: scale(0.97); }.ks-social-flex { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }.ks-social-icon {width: 44px; height: 44px; border-radius: 12px; background: rgba(255, 255, 255, 0.04);border: 1px solid var(--ks-foot-border); display: flex; align-items: center; justify-content: center;color: var(--ks-foot-text-main); text-decoration: none; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);}.ks-social-icon svg { width: 20px; height: 20px; fill: currentColor; transition: all 0.3s ease; }.ks-social-icon:hover {background: var(--ks-foot-emerald); border-color: var(--ks-foot-emerald);color: white; transform: translateY(-6px) scale(1.05);box-shadow: 0 10px 20px rgba(16, 185, 129, 0.25);}/* 5. App Download Block */.ks-app-links { display: flex; flex-direction: column; gap: 14px; }.ks-app-btn {display: flex; align-items: center; gap: 14px; background: rgba(0,0,0,0.3); color: #fff;text-decoration: none; padding: 12px 18px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;}.ks-app-btn:hover { background: #000; border-color: var(--ks-foot-accent); transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }.ks-app-btn svg { width: 28px; height: 28px; fill: #fff; }.ks-app-text span { display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #aaa; margin-bottom: 2px;}.ks-app-text strong { font-size: 1.1rem; font-family: sans-serif; font-weight: 700; line-height: 1; display: block;}/* Bottom Bar */.ks-foot-bottom { background: var(--ks-foot-bg-bottom); border-top: 1px solid var(--ks-foot-border); padding: 24px 20px; }.ks-foot-bottom-container { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; align-items: center; text-align: center; }@media (min-width: 768px) { .ks-foot-bottom-container { flex-direction: row; justify-content: space-between; text-align: left; } }.ks-copyright { font-size: 0.85rem; color: var(--ks-foot-text-muted); margin: 0; font-weight: 500;}.ks-copyright strong { color: var(--ks-foot-text-main); font-weight: 700; }.ks-payment-icons { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }.ks-payment-icons svg { height: 26px; width: 40px; opacity: 0.8; transition: opacity 0.3s ease; }.ks-payment-icons svg:hover { opacity: 1; }.ks-payment-cod {font-size: 0.75rem; font-weight: 800; color: var(--ks-foot-emerald);background: var(--ks-foot-emerald-glow); border: 1px solid rgba(16,185,129,0.3);padding: 6px 12px; border-radius: 6px; letter-spacing: 0.05em; text-transform: uppercase;}{%- endstyle -%}{%- if section.settings.show_wave -%}{%- endif -%}  {%- for block in section.blocks -%}
    {%- case block.type -%}
      
      {%- when 'brand_contact' -%}
        <div class="ks-foot-brand ks-foot-col" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            <a href="{{ routes.root_url }}" class="ks-foot-logo">
              <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width: {{ block.settings.logo_width }}px; height: auto;">
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="ks-foot-logo">
              <div class="ks-foot-logo-icon">🌱</div>
              <div class="ks-foot-logo-text">{{ shop.name }}</div>
            </a>
          {%- endif -%}
          
          {%- if block.settings.description != blank -%}
            <p class="ks-foot-desc">{{ block.settings.description }}</p>
          {%- endif -%}

          <ul class="ks-foot-contact-list">
            {%- if block.settings.address != blank -%}
              <li class="ks-foot-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{{ block.settings.address }}</span>
              </li>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <li class="ks-foot-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <span><strong>हेल्पलाइन (Toll-Free):</strong><br><a href="tel:{{ block.settings.phone }}" style="color: var(--ks-foot-accent); text-decoration: none; font-size: 1.15rem; font-weight: 800; display:block; margin-top: 4px;">{{ block.settings.phone }}</a></span>
              </li>
            {%- endif -%}
          </ul>
        </div>

      {%- when 'link_list' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading | default: block.settings.menu.title }}</h4>
          {%- if block.settings.menu != blank -%}
            <ul class="ks-foot-links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

      {%- when 'trust_badges' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
          <div class="ks-trust-badges">
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg></div>
              <div class="ks-trust-text"><strong>100% ओरिजिनल गारंटी</strong><span>पक्के जीएसटी बिल के साथ</span></div>
            </div>
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></div>
              <div class="ks-trust-text"><strong>फ़ास्ट होम डिलीवरी</strong><span>बिहार के सभी 38 जिलों में</span></div>
            </div>
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></div>
              <div class="ks-trust-text"><strong>कैश ऑन डिलीवरी (COD)</strong><span>सामान मिलने पर पैसे दें</span></div>
            </div>
          </div>
        </div>

      {%- when 'newsletter' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
          <div class="ks-foot-newsletter">
            <p style="margin: 0; font-size: 0.95rem; line-height: 1.6;">{{ block.settings.subtext }}</p>
            
            {%- form 'customer', id: 'ContactFooter', class: 'contact-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="ks-newsletter-form">
                <input type="email" name="contact[email]" class="ks-newsletter-input" placeholder="अपना ईमेल दर्ज करें..." required>
                <button type="submit" class="ks-newsletter-btn">जुड़ें</button>
              </div>
            {%- endform -%}

            {%- if block.settings.show_social -%}
              <div class="ks-social-flex">
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <a href="{{ settings.social_youtube_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.16 1 12 1 12s0 3.84.46 5.58a2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.84 23 12 23 12s0-3.84-.46-5.58zM9.5 15.5v-7l6.5 3.5-6.5 3.5z"></path></svg></a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      
      {%- when 'app_download' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
           <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
           <p style="margin: 0 0 20px 0; font-size: 0.95rem; line-height: 1.6;">{{ block.settings.subtext }}</p>
           <div class="ks-app-links">
             {% if block.settings.playstore_link != blank %}
             <a href="{{ block.settings.playstore_link }}" target="_blank" class="ks-app-btn">
               <svg viewBox="0 0 24 24"><path d="M3 2v20l18-10L3 2z" fill="#00e676"/><path d="M3 2v20l8.5-10L3 2z" fill="#00c853"/></svg>
               <div class="ks-app-text"><span>Get it on</span><strong>Google Play</strong></div>
             </a>
             {% endif %}
             {% if block.settings.appstore_link != blank %}
             <a href="{{ block.settings.appstore_link }}" target="_blank" class="ks-app-btn">
               <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm3.36 14.82c-.8.4-1.78.61-2.73.61-3.6 0-6.17-2.6-6.17-6.24 0-3.66 2.4-6.32 5.9-6.32.96 0 1.95.23 2.76.65v2.24c-.8-.44-1.63-.64-2.45-.64-2.22 0-3.87 1.52-3.87 4.07s1.65 4.05 3.9 4.05c.87 0 1.7-.22 2.6-.7v2.28z" fill="#fff"/></svg>
               <div class="ks-app-text"><span>Download on the</span><strong>App Store</strong></div>
             </a>
             {% endif %}
           </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}

</div>
  {%- if section.settings.payment_enable -%}
    <div class="ks-payment-icons">
      <span class="ks-payment-cod">✓ COD Available</span>
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}{"name": "Footer V2 (Interactive)","settings": [{"type": "header","content": "Decorations & Wave"},{"type": "checkbox","id": "show_wave","label": "Show Top Decorative Wave","default": true},{"type": "color","id": "wave_color","label": "Wave Color","info": "Match this to the background color of the section above the footer.","default": "#ffffff"},{"type": "header","content": "Theme Colors"},{"type": "color","id": "bg_color","label": "Main Background","default": "#051a11"},{"type": "color","id": "bg_bottom_color","label": "Bottom Bar Background","default": "#03100a"},{"type": "color","id": "heading_color","label": "Heading Text","default": "#f8fafc"},{"type": "color","id": "text_color","label": "Body Text","default": "#94a3b8"},{"type": "color","id": "accent_color","label": "Accent / Highlight Color","default": "#fbbf24"},{"type": "header","content": "Bottom Bar Settings"},{"type": "text","id": "copyright_text","label": "Copyright Text","default": "All Rights Reserved. Made for Farmers."},{"type": "checkbox","id": "payment_enable","label": "Show Payment & COD Badges","default": true},{"type": "header","content": "Spacing"},{"type": "range","id": "margin_top","min": 0,"max": 100,"step": 4,"unit": "px","label": "Top Margin","default": 0},{"type": "range","id": "padding_top","min": 20,"max": 120,"step": 4,"unit": "px","label": "Top Padding (Inside)","default": 100},{"type": "range","id": "padding_bottom","min": 20,"max": 120,"step": 4,"unit": "px","label": "Bottom Padding (Inside)","default": 72}],"blocks": [{"type": "brand_contact","name": "Brand & Contact Info","limit": 1,"settings": [{"type": "image_picker","id": "logo","label": "Custom Logo"},{"type": "range","id": "logo_width","min": 50,"max": 250,"step": 10,"unit": "px","label": "Logo Width","default": 160},{"type": "textarea","id": "description","label": "Description","default": "बिहार का नं. 1 और सबसे भरोसेमंद कृषि ई-कॉमर्स प्लेटफॉर्म। किसानों को 100% असली बीज, खाद और मशीनरी सीधे घर तक पहुँचाने का संक