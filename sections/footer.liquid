                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <a href="{{ settings.social_youtube_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.16 1 12 1 12s0 3.84.46 5.58a2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.84 23 12 23 12s0-3.84-.46-5.58zM9.5 15.5v-7l6.5 3.5-6.5 3.5z"></path></svg></a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      
      {%- when 'app_download' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
           <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
           <p style="margin: 0 0 16px 0; font-size: 0.95rem; line-height: 1.5;">{{ block.settings.subtext }}</p>
           <div class="ks-app-links">
             {% if block.settings.playstore_link != blank %}
             <a href="{{ block.settings.playstore_link }}" target="_blank" class="ks-app-btn">
               <svg viewBox="0 0 24 24"><path d="M3 2v20l18-10L3 2z" fill="#00e676"/><path d="M3 2v20l8.5-10L3 2z" fill="#00c853"/></svg>
               <div class="ks-app-text"><span>Get it on</span><strong>Google Play</strong></div>
             </a>
             {% endif %}
             {% if block.settings.appstore_link != blank %}
             <a href="{{ block.settings.appstore_link }}" target="_blank" class="ks-app-btn">
               <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm3.36 14.82c-.8.4-1.78.61-2.73.61-3.6 0-6.17-2.6-6.17-6.24 0-3.66 2.4-6.32 5.9-6.32.96 0 1.95.23 2.76.65v2.24c-.8-.44-1.63-.64-2.45-.64-2.22 0-3.87 1.52-3.87 4.07s1.65 4.05 3.9 4.05c.87 0 1.7-.22 2.6-.7v2.28z" fill="#fff"/></svg>
               <div class="ks-app-text"><span>Download on the</span><strong>App Store</strong></div>
             </a>
             {% endif %}
           </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}

</div>
  {%- if section.settings.payment_enable -%}
    <div class="ks-payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
