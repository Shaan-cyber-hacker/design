{%- style -%}/* --- BASE SECTION VARIABLES --- /
.ks-super-footer-{{ section.id }} {
/ Colors */--ks-bg-main: {{ section.settings.bg_color }};--ks-bg-bottom: {{ section.settings.bg_bottom_color }};--ks-text-heading: {{ section.settings.heading_color }};--ks-text-body: {{ section.settings.text_color }};--ks-accent: {{ section.settings.accent_color }};--ks-border: rgba(255, 255, 255, 0.08);--ks-emerald: #10b981;--ks-emerald-glow: rgba(16, 185, 129, 0.15);/* Typography Customization */--ks-font-heading: {{ section.settings.heading_size }}px;--ks-font-body: {{ section.settings.body_size }}px;/* Spacing & Layout */--ks-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px;--ks-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;--ks-pad-top-desktop: {{ section.settings.padding_top }}px;--ks-pad-bottom-desktop: {{ section.settings.padding_bottom }}px;--ks-horizontal-padding: clamp(24px, 5vw, 64px);--ks-max-width: {{ section.settings.max_width }}px;background: var(--ks-bg-main);color: var(--ks-text-body);font-family: 'Plus Jakarta Sans', system-ui, sans-serif;margin-top: {{ section.settings.margin_top }}px;position: relative;overflow: hidden;border-top: 1px solid var(--ks-border);}/* Decorative Background Blur */.ks-super-footer-{{ section.id }}::before {content: '';position: absolute;top: -150px;left: -100px;width: 600px;height: 600px;background: radial-gradient(circle, var(--ks-emerald-glow) 0%, rgba(255,255,255,0) 70%);border-radius: 50%;pointer-events: none;z-index: 0;opacity: 0.7;}/* --- LAYOUT CONTAINERS --- */.ks-sf-inner {max-width: var(--ks-max-width);margin: 0 auto;padding: var(--ks-pad-top-mobile) var(--ks-horizontal-padding) var(--ks-pad-bottom-mobile);position: relative;z-index: 2;}@media (min-width: 768px) {.ks-sf-inner {padding: var(--ks-pad-top-desktop) var(--ks-horizontal-padding) var(--ks-pad-bottom-desktop);}}/* Advanced Auto-Fit Grid for Perfect Balance */.ks-sf-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));gap: clamp(40px, 6vw, 72px);}/* Block Titles */.ks-sf-title {font-size: var(--ks-font-heading);font-weight: 800;color: var(--ks-text-heading);margin: 0 0 28px 0;position: relative;padding-bottom: 12px;letter-spacing: 0.02em;line-height: 1.3;}.ks-sf-title::after {content: '';position: absolute;left: 0;bottom: 0;width: 40px;height: 3px;background: var(--ks-accent);border-radius: 4px;transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);}.ks-sf-block:hover .ks-sf-title::after {width: 80px;}/* --- 1. BRAND BLOCK --- */.ks-sf-logo-wrapper { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; margin-bottom: 20px; transition: transform 0.3s ease; }.ks-sf-logo-wrapper:hover { transform: translateY(-3px); }.ks-sf-logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--ks-emerald), #047857); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25); }.ks-sf-logo-text { font-size: clamp(22px, 2vw, 28px); font-weight: 900; color: var(--ks-text-heading); letter-spacing: -0.02em; }.ks-sf-desc { font-size: var(--ks-font-body); line-height: 1.7; color: var(--ks-text-body); margin: 0 0 24px 0; }.ks-sf-contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; }.ks-sf-contact-item { display: flex; align-items: flex-start; gap: 14px; font-size: var(--ks-font-body); line-height: 1.5; transition: transform 0.3s ease; }.ks-sf-contact-item:hover { transform: translateX(6px); color: var(--ks-text-heading); }.ks-sf-contact-item svg { width: 22px; height: 22px; color: var(--ks-accent); margin-top: 2px; flex-shrink: 0; }/* --- 2. MENU LINKS --- */.ks-sf-menu { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }.ks-sf-menu a { color: var(--ks-text-body); text-decoration: none; font-size: var(--ks-font-body); font-weight: 500; transition: all 0.3s ease; display: inline-flex; align-items: center; position: relative; width: fit-content; }.ks-sf-menu a::after { content: ''; position: absolute; width: 0; height: 1px; bottom: -2px; left: 0; background-color: var(--ks-accent); transition: width 0.3s ease; }.ks-sf-menu a:hover { color: var(--ks-text-heading); transform: translateX(6px); }.ks-sf-menu a:hover::after { width: 100%; }/* --- 3. TRUST BADGES --- */.ks-sf-trust-box { display: flex; flex-direction: column; gap: 16px; }.ks-sf-trust-item { display: flex; align-items: center; gap: 16px; background: rgba(255,255,255,0.03); padding: 14px 18px; border-radius: 16px; border: 1px solid var(--ks-border); transition: all 0.4s ease; cursor: default; }.ks-sf-trust-item:hover { background: rgba(255,255,255,0.06); border-color: var(--ks-emerald); transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.15); }.ks-sf-trust-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--ks-emerald-glow); color: var(--ks-emerald); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s ease; }.ks-sf-trust-item:hover .ks-sf-trust-icon { background: var(--ks-emerald); color: #fff; transform: scale(1.1) rotate(5deg); }.ks-sf-trust-text strong { display: block; color: var(--ks-text-heading); font-size: calc(var(--ks-font-body) + 1px); font-weight: 700; margin-bottom: 2px;}.ks-sf-trust-text span { font-size: calc(var(--ks-font-body) - 1px); color: var(--ks-text-body); }/* --- 4. NEWSLETTER --- */.ks-sf-newsletter-form { display: flex; position: relative; margin-top: 24px; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }.ks-sf-newsletter-input { width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--ks-border); padding: 18px 20px; color: var(--ks-text-heading); font-size: var(--ks-font-body); outline: none; transition: all 0.3s ease; }.ks-sf-newsletter-input:focus { background: rgba(255, 255, 255, 0.08); border-color: var(--ks-emerald); box-shadow: inset 0 0 0 1px var(--ks-emerald); }.ks-sf-newsletter-btn { position: absolute; right: 6px; top: 6px; bottom: 6px; background: var(--ks-accent); color: #000; border: none; border-radius: 10px; padding: 0 24px; font-weight: 800; cursor: pointer; transition: all 0.3s ease; }.ks-sf-newsletter-btn:hover { transform: scale(0.96); background: #f59e0b; }/* --- 5. SOCIAL MEDIA --- */.ks-sf-social-grid { display: flex; flex-wrap: wrap; gap: 14px; }.ks-sf-social-icon { width: 48px; height: 48px; border-radius: 14px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--ks-border); display: flex; align-items: center; justify-content: center; color: var(--ks-text-heading); text-decoration: none; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }.ks-sf-social-icon svg { width: 22px; height: 22px; fill: currentColor; transition: all 0.3s ease; }.ks-sf-social-icon:hover { background: var(--ks-emerald); border-color: var(--ks-emerald); color: white; transform: translateY(-6px) scale(1.05); box-shadow: 0 12px 24px var(--ks-emerald-glow); }/* --- 6. APP DOWNLOADS --- */.ks-sf-app-links { display: flex; flex-direction: column; gap: 16px; }.ks-sf-app-btn { display: flex; align-items: center; gap: 16px; background: rgba(0,0,0,0.4); color: #fff; text-decoration: none; padding: 14px 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); transition: all 0.3s ease; }.ks-sf-app-btn:hover { background: #000; border-color: var(--ks-accent); transform: translateY(-4px); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }.ks-sf-app-btn svg { width: 32px; height: 32px; fill: #fff; }.ks-sf-app-text span { display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #aaa; margin-bottom: 2px;}.ks-sf-app-text strong { font-size: 1.15rem; font-family: sans-serif; font-weight: 700; line-height: 1; display: block;}/* --- 7. IMAGE GALLERY --- */.ks-sf-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }.ks-sf-gallery-img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; transition: transform 0.4s ease; border: 1px solid var(--ks-border); }.ks-sf-gallery-item { overflow: hidden; border-radius: 12px; display: block; }.ks-sf-gallery-item:hover .ks-sf-gallery-img { transform: scale(1.15) rotate(2deg); opacity: 0.8; }/* --- 8. STORE FEATURES LIST --- */.ks-sf-features { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }.ks-sf-feature-item { display: flex; align-items: center; gap: 12px; font-size: var(--ks-font-body); color: var(--ks-text-body); }.ks-sf-feature-icon { color: var(--ks-emerald); font-size: 1.1rem; flex-shrink: 0; background: var(--ks-emerald-glow); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }/* --- 9. BUSINESS HOURS --- */.ks-sf-hours { display: flex; flex-direction: column; gap: 12px; }.ks-sf-hour-row { display: flex; justify-content: space-between; font-size: var(--ks-font-body); color: var(--ks-text-body); padding-bottom: 8px; border-bottom: 1px dashed rgba(255,255,255,0.05); transition: color 0.3s ease; }.ks-sf-hour-row:hover { color: var(--ks-text-heading); border-color: rgba(255,255,255,0.2); }/* --- 10. MAP EMBED --- */.ks-sf-map-container { width: 100%; border-radius: 16px; overflow: hidden; border: 1px solid var(--ks-border); line-height: 0; }.ks-sf-map-container iframe { width: 100%; height: 200px; border: none; filter: invert(90%) hue-rotate(180deg) contrast(80%); transition: filter 0.3s ease; }.ks-sf-map-container iframe:hover { filter: none; }/* --- BOTTOM BAR --- */.ks-sf-bottom { background: var(--ks-bg-bottom); border-top: 1px solid var(--ks-border); padding: 32px var(--ks-horizontal-padding); }.ks-sf-bottom-inner { max-width: var(--ks-max-width); margin: 0 auto; display: flex; flex-direction: column; gap: 24px; align-items: center; text-align: center; }@media (min-width: 992px) { .ks-sf-bottom-inner { flex-direction: row; justify-content: space-between; text-align: left; } }.ks-sf-copyright { font-size: calc(var(--ks-font-body) - 1px); color: var(--ks-text-body); margin: 0; font-weight: 500;}.ks-sf-copyright strong { color: var(--ks-text-heading); font-weight: 800; }.ks-sf-payments { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }.ks-sf-payments svg { height: 28px; width: 44px; opacity: 0.7; transition: opacity 0.3s ease, transform 0.3s ease; }.ks-sf-payments svg:hover { opacity: 1; transform: scale(1.1); }{%- endstyle -%}  {%- for block in section.blocks -%}
    <div class="ks-sf-block" {{ block.shopify_attributes }}>
      
      {%- if block.settings.heading != blank -%}
        <h4 class="ks-sf-title">{{ block.settings.heading }}</h4>
      {%- endif -%}

      {%- case block.type -%}
        
        {%- when 'brand', 'brand_contact', 'brand_information' -%}
          {%- if block.settings.logo != blank -%}
            <a href="{{ routes.root_url }}" class="ks-sf-logo-wrapper">
              <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width: {{ block.settings.logo_width }}px; height: auto;">
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="ks-sf-logo-wrapper">
              <div class="ks-sf-logo-icon">🌱</div>
              <div class="ks-sf-logo-text">{{ shop.name }}</div>
            </a>
          {%- endif -%}
          
          {%- if block.settings.desc != blank -%}
            <p class="ks-sf-desc">{{ block.settings.desc }}</p>
          {%- endif -%}

          <ul class="ks-sf-contact-list">
            {%- if block.settings.address != blank -%}
              <li class="ks-sf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{{ block.settings.address }}</span>
              </li>
               <li class="ks-sf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{{ block.settings.address }}</span>
              </li>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <li class="ks-sf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <span><strong style="color:var(--ks-text-heading); display:block; margin-bottom:2px;">Call Support:</strong><a href="tel:{{ block.settings.phone }}" style="color: var(--ks-accent); text-decoration: none; font-size: 1.1rem; font-weight: 800;">{{ block.settings.phone }}</a></span>
              </li>
            {%- endif -%}
          </ul>

        {%- when 'link_list' -%}
          {%- if block.settings.menu != blank -%}
            <ul class="ks-sf-menu">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- when 'trust_badges' -%}
          <div class="ks-sf-trust-box">
            <div class="ks-sf-trust-item">
              <div class="ks-sf-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg></div>
              <div class="ks-sf-trust-text"><strong>{{ block.settings.t1_head }}</strong><span>{{ block.settings.t1_sub }}</span></div>
            </div>
            <div class="ks-sf-trust-item">
              <div class="ks-sf-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="3" width="15" height="13" rx="2"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon></svg></div>
              <div class="ks-sf-trust-text"><strong>{{ block.settings.t2_head }}</strong><span>{{ block.settings.t2_sub }}</span></div>
            </div>
            <div class="ks-sf-trust-item">
              <div class="ks-sf-trust-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></div>
              <div class="ks-sf-trust-text"><strong>{{ block.settings.t3_head }}</strong><span>{{ block.settings.t3_sub }}</span></div>
            </div>
          </div>

        {%- when 'newsletter' -%}
          <p class="ks-sf-desc" style="margin-bottom: 0;">{{ block.settings.subtext }}</p>
          {%- form 'customer', id: 'FooterNewsletterForm', class: 'contact-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ks-sf-newsletter-form">
              <input type="email" name="contact[email]" class="ks-sf-newsletter-input" placeholder="Your email address..." required>
              <button type="submit" class="ks-sf-newsletter-btn">Join</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p style="color: var(--ks-emerald); font-size: 0.85rem; margin-top: 10px; font-weight: 700;">✓ Thanks for subscribing!</p>
            {%- endif -%}
          {%- endform -%}

        {%- when 'social' -%}
          <p class="ks-sf-desc">{{ block.settings.subtext }}</p>
          <div class="ks-sf-social-grid">
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" class="ks-sf-social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" class="ks-sf-social-icon"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a href="{{ settings.social_youtube_link }}" target="_blank" class="ks-sf-social-icon"><svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.16 1 12 1 12s0 3.84.46 5.58a2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.84 23 12 23 12s0-3.84-.46-5.58zM9.5 15.5v-7l6.5 3.5-6.5 3.5z"></path></svg></a>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <a href="{{ settings.social_twitter_link }}" target="_blank" class="ks-sf-social-icon"><svg viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
            {%- endif -%}
          </div>

        {%- when 'app_download' -%}
          <p class="ks-sf-desc">{{ block.settings.subtext }}</p>
          <div class="ks-sf-app-links">
            {% if block.settings.playstore != blank %}
            <a href="{{ block.settings.playstore }}" target="_blank" class="ks-sf-app-btn">
              <svg viewBox="0 0 24 24"><path d="M3 2v20l18-10L3 2z" fill="#00e676"/><path d="M3 2v20l8.5-10L3 2z" fill="#00c853"/></svg>
              <div class="ks-sf-app-text"><span>Get it on</span><strong>Google Play</strong></div>
            </a>
            {% endif %}
            {% if block.settings.appstore != blank %}
            <a href="{{ block.settings.appstore }}" target="_blank" class="ks-sf-app-btn">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm3.36 14.82c-.8.4-1.78.61-2.73.61-3.6 0-6.17-2.6-6.17-6.24 0-3.66 2.4-6.32 5.9-6.32.96 0 1.95.23 2.76.65v2.24c-.8-.44-1.63-.64-2.45-.64-2.22 0-3.87 1.52-3.87 4.07s1.65 4.05 3.9 4.05c.87 0 1.7-.22 2.6-.7v2.28z" fill="#fff"/></svg>
              <div class="ks-sf-app-text"><span>Download on the</span><strong>App Store</strong></div>
            </a>
            {% endif %}
          </div>

        {%- when 'store_features' -%}
          <ul class="ks-sf-features">
            {% if block.settings.f1 != blank %}<li class="ks-sf-feature-item"><div class="ks-sf-feature-icon">✓</div><span>{{ block.settings.f1 }}</span></li>{% endif %}
            {% if block.settings.f2 != blank %}<li class="ks-sf-feature-item"><div class="ks-sf-feature-icon">✓</div><span>{{ block.settings.f2 }}</span></li>{% endif %}
            {% if block.settings.f3 != blank %}<li class="ks-sf-feature-item"><div class="ks-sf-feature-icon">✓</div><span>{{ block.settings.f3 }}</span></li>{% endif %}
            {% if block.settings.f4 != blank %}<li class="ks-sf-feature-item"><div class="ks-sf-feature-icon">✓</div><span>{{ block.settings.f4 }}</span></li>{% endif %}
          </ul>

        {%- when 'business_hours' -%}
          <div class="ks-sf-hours">
            {% if block.settings.h1 != blank %}<div class="ks-sf-hour-row"><span>Monday - Friday</span><span>{{ block.settings.h1 }}</span></div>{% endif %}
            {% if block.settings.h2 != blank %}<div class="ks-sf-hour-row"><span>Saturday</span><span>{{ block.settings.h2 }}</span></div>{% endif %}
            {% if block.settings.h3 != blank %}<div class="ks-sf-hour-row"><span>Sunday</span><span style="color:var(--ks-accent);">{{ block.settings.h3 }}</span></div>{% endif %}
          </div>

        {%- when 'image_gallery', 'image' -%}
          <div class="ks-sf-gallery">
            {% for i in (1..6) %}
              {% capture img_key %}img_{{ i }}{% endcapture %}
              {% if block.settings[img_key] != blank %}
                <a href="{{ block.settings.link | default: '#' }}" class="ks-sf-gallery-item">
                  <img src="{{ block.settings[img_key] | image_url: width: 200 }}" class="ks-sf-gallery-img" alt="Gallery Image" loading="lazy">
                </a>
              {% endif %}
            {% endfor %}
          </div>

        {%- when 'map_embed' -%}
          <div class="ks-sf-map-container">
            {{ block.settings.map_iframe }}
          </div>

        {%- when 'text', 'custom_text' -%}
          <div class="ks-sf-desc">
            {{ block.settings.custom_richtext }}
            {% if block.settings.subtext != blank %}
              {{ block.settings.subtext }}
            {% endif %}
          </div>

      {%- endcase -%}
    </div>
  {%- endfor -%}

</div>
  {%- if section.settings.show_payments -%}
    <div class="ks-sf-payments">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
