{%- style -%}
.ks-footer-wrapper {
--ks-foot-bg: {{ section.settings.bg_color }};
--ks-foot-bg-bottom: {{ section.settings.bg_bottom_color }};
--ks-foot-text-main: {{ section.settings.heading_color }};
--ks-foot-text-muted: {{ section.settings.text_color }};
--ks-foot-accent: {{ section.settings.accent_color }};
--ks-foot-border: rgba(255, 255, 255, 0.08);
--ks-foot-emerald: #10b981;font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
background: var(--ks-foot-bg);
color: var(--ks-foot-text-muted);
position: relative;
overflow: hidden;
margin-top: {{ section.settings.margin_top }}px;
padding-top: {{ section.settings.padding_top }}px; 
}/* Decorative Top Wave */
.ks-footer-wave {
position: absolute;
top: 0;
left: 0;
width: 100%;
overflow: hidden;
line-height: 0;
transform: translateY(-1px);
}
.ks-footer-wave svg {
display: block;
width: calc(100% + 1.3px);
height: 40px;
}
@media (min-width: 768px) {
.ks-footer-wave svg { height: 60px; }
}/* Background Glow Decor */
.ks-footer-wrapper::before {
content: '';
position: absolute;
top: 0;
right: 10%;
width: 500px;
height: 500px;
background: radial-gradient(circle, rgba(16, 185, 129, 0.04) 0%, rgba(255,255,255,0) 70%);
border-radius: 50%;
pointer-events: none;
}.ks-footer-container {
max-width: 1280px;
margin: 0 auto;
padding: 0 20px {{ section.settings.padding_bottom }}px 20px;
position: relative;
z-index: 2;
}.ks-foot-grid {
display: grid;
grid-template-columns: 1fr;
gap: 48px;
}
@media (min-width: 640px) {
.ks-foot-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
.ks-foot-grid {
grid-template-columns: 1.5fr repeat({{ section.blocks.size | minus: 1 }}, 1fr);
gap: 64px;
}
}/* Titles */
.ks-foot-col-title {
font-size: 1.15rem;
font-weight: 800;
color: var(--ks-foot-text-main);
margin: 0 0 24px 0;
position: relative;
padding-bottom: 12px;
}
.ks-foot-col-title::after {
content: '';
position: absolute;
left: 0;
bottom: 0;
width: 40px;
height: 3px;
background: var(--ks-foot-accent);
border-radius: 2px;
}/* 1. Brand Block Styling */
.ks-foot-brand { display: flex; flex-direction: column; gap: 20px; }
.ks-foot-logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
.ks-foot-logo-icon {
width: 44px; height: 44px;
background: linear-gradient(135deg, var(--ks-foot-emerald), #047857);
border-radius: 12px; display: flex; align-items: center; justify-content: center;
font-size: 22px; box-shadow: 0 8px 16px rgba(4, 120, 87, 0.3);
}
.ks-foot-logo-text { font-size: 26px; font-weight: 900; color: var(--ks-foot-text-main); letter-spacing: -0.02em; }
.ks-foot-logo-text span { color: var(--ks-foot-accent); }
.ks-foot-desc { font-size: 0.95rem; line-height: 1.7; margin: 0; }
.ks-foot-contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
.ks-foot-contact-item { display: flex; align-items: flex-start; gap: 12px; font-size: 0.9rem; line-height: 1.5; }
.ks-foot-contact-item svg { width: 20px; height: 20px; color: var(--ks-foot-accent); margin-top: 2px; flex-shrink: 0; }/* 2. Menu Links */
.ks-foot-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
.ks-foot-links a { color: var(--ks-foot-text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px; }
.ks-foot-links a::before { content: '›'; font-size: 1rem; color: var(--ks-foot-emerald); font-weight: bold; transition: all 0.3s ease; }
.ks-foot-links a:hover { color: var(--ks-foot-accent); transform: translateX(6px); }/* 3. Newsletter & Social */
.ks-newsletter-form { display: flex; position: relative; margin-top: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
.ks-newsletter-input {
width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--ks-foot-border);
padding: 14px 16px; border-radius: 12px; color: white; font-size: 0.95rem; outline: none; transition: all 0.3s ease;
}
.ks-newsletter-input:focus { border-color: var(--ks-foot-accent); background: rgba(255, 255, 255, 0.08); }
.ks-newsletter-btn {
position: absolute; right: 4px; top: 4px; bottom: 4px; background: var(--ks-foot-accent);
color: #000; border: none; border-radius: 8px; padding: 0 20px; font-weight: 800; cursor: pointer; transition: all 0.3s ease;
}
.ks-newsletter-btn:hover { background: #f59e0b; }.ks-social-flex { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
.ks-social-icon {
width: 42px; height: 42px; border-radius: 10px; background: rgba(255, 255, 255, 0.05);
border: 1px solid var(--ks-foot-border); display: flex; align-items: center; justify-content: center;
color: var(--ks-foot-text-main); text-decoration: none; transition: all 0.3s ease;
}
.ks-social-icon svg { width: 20px; height: 20px; fill: currentColor; }
.ks-social-icon:hover { background: var(--ks-foot-emerald); border-color: var(--ks-foot-emerald); color: white; transform: translateY(-4px); }/* 4. Decorative Trust Badges Block */
.ks-trust-badges { display: flex; flex-direction: column; gap: 16px; }
.ks-trust-badge-item { display: flex; align-items: center; gap: 14px; background: rgba(255,255,255,0.03); padding: 12px; border-radius: 12px; border: 1px solid var(--ks-foot-border); }
.ks-trust-icon { width: 40px; height: 40px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); color: var(--ks-foot-emerald); display: flex; align-items: center; justify-content: center; }
.ks-trust-text strong { display: block; color: var(--ks-foot-text-main); font-size: 0.95rem; }
.ks-trust-text span { font-size: 0.8rem; color: var(--ks-foot-text-muted); }/* 5. App Download Block */
.ks-app-links { display: flex; flex-direction: column; gap: 12px; }
.ks-app-btn {
display: flex; align-items: center; gap: 12px; background: #000; color: #fff;
text-decoration: none; padding: 10px 16px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s;
}
.ks-app-btn:hover { background: #222; border-color: var(--ks-foot-accent); }
.ks-app-btn svg { width: 24px; height: 24px; fill: #fff; }
.ks-app-text span { display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: #aaa; }
.ks-app-text strong { font-size: 1rem; font-family: sans-serif; }/* Bottom Bar */
.ks-foot-bottom { background: var(--ks-foot-bg-bottom); border-top: 1px solid var(--ks-foot-border); padding: 24px 20px; }
.ks-foot-bottom-container { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; }
@media (min-width: 768px) { .ks-foot-bottom-container { flex-direction: row; justify-content: space-between; text-align: left; } }
.ks-copyright { font-size: 0.85rem; color: var(--ks-foot-text-muted); margin: 0; }
.ks-payment-icons { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
.ks-payment-icons svg { height: 26px; width: 40px; opacity: 0.9; }
{%- endstyle -%}{%- if section.settings.show_wave -%}





{%- endif -%}  {%- for block in section.blocks -%}
    {%- case block.type -%}
      
      {%- when 'brand_contact' -%}
        <div class="ks-foot-brand" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width: {{ block.settings.logo_width }}px; height: auto;">
          {%- else -%}
            <a href="{{ routes.root_url }}" class="ks-foot-logo">
              <div class="ks-foot-logo-icon">🌱</div>
              <div class="ks-foot-logo-text">{{ shop.name }}</div>
            </a>
          {%- endif -%}
          
          {%- if block.settings.description != blank -%}
            <p class="ks-foot-desc">{{ block.settings.description }}</p>
          {%- endif -%}

          <ul class="ks-foot-contact-list">
            {%- if block.settings.address != blank -%}
              <li class="ks-foot-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{{ block.settings.address }}</span>
              </li>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <li class="ks-foot-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <span><strong>हेल्पलाइन (Toll-Free):</strong><br><a href="tel:{{ block.settings.phone }}" style="color: var(--ks-foot-accent); text-decoration: none; font-size: 1.1rem; font-weight: bold;">{{ block.settings.phone }}</a></span>
              </li>
            {%- endif -%}
          </ul>
        </div>

      {%- when 'link_list' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading | default: block.settings.menu.title }}</h4>
          {%- if block.settings.menu != blank -%}
            <ul class="ks-foot-links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

      {%- when 'trust_badges' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
          <div class="ks-trust-badges">
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg></div>
              <div class="ks-trust-text"><strong>100% ओरिजिनल गारंटी</strong><span>पक्के जीएसटी बिल के साथ</span></div>
            </div>
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon></svg></div>
              <div class="ks-trust-text"><strong>फ़ास्ट होम डिलीवरी</strong><span>बिहार के सभी 38 जिलों में</span></div>
            </div>
            <div class="ks-trust-badge-item">
              <div class="ks-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></div>
              <div class="ks-trust-text"><strong>कैश ऑन डिलीवरी (COD)</strong><span>सामान मिलने पर पैसे दें</span></div>
            </div>
          </div>
        </div>

      {%- when 'newsletter' -%}
        <div class="ks-foot-col" {{ block.shopify_attributes }}>
          <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
          <div class="ks-foot-newsletter">
            <p style="margin: 0; font-size: 0.95rem; line-height: 1.6;">{{ block.settings.subtext }}</p>
            
            {%- form 'customer', id: 'ContactFooter', class: 'contact-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="ks-newsletter-form">
                <input type="email" name="contact[email]" class="ks-newsletter-input" placeholder="अपना ईमेल दर्ज करें..." required>
                <button type="submit" class="ks-newsletter-btn">जुड़ें</button>
              </div>
            {%- endform -%}

            {%- if block.settings.show_social -%}
              <div class="ks-social-flex">
                {%- if settings.social_facebook_link != blank -%}
