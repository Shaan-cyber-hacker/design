{% comment %}
  KRISHISATHI PREMIUM FOOTER SECTION
  100% Customizable via Shopify Theme Editor
{% endcomment %}

{%- style -%}
  .ks-footer-wrapper {
    --ks-foot-bg: {{ section.settings.bg_color }};
    --ks-foot-bg-bottom: {{ section.settings.bg_bottom_color }};
    --ks-foot-text-main: {{ section.settings.heading_color }};
    --ks-foot-text-muted: {{ section.settings.text_color }};
    --ks-foot-accent: {{ section.settings.accent_color }};
    --ks-foot-border: rgba(255, 255, 255, 0.08);
    --ks-foot-emerald: #10b981;
    
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    background: var(--ks-foot-bg);
    color: var(--ks-foot-text-muted);
    position: relative;
    overflow: hidden;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .ks-footer-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.03) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .ks-footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px 20px;
    position: relative;
    z-index: 2;
  }

  .ks-foot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 640px) {
    .ks-foot-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .ks-foot-grid {
      grid-template-columns: 1.5fr repeat({{ section.blocks.size | minus: 1 }}, 1fr);
      gap: 64px;
    }
  }

  /* Brand Block */
  .ks-foot-brand { display: flex; flex-direction: column; gap: 20px; }
  .ks-foot-logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .ks-foot-logo-icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, var(--ks-foot-emerald), #047857);
    border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px;
  }
  .ks-foot-logo-text { font-size: 24px; font-weight: 900; color: var(--ks-foot-text-main); letter-spacing: -0.02em; }
  .ks-foot-logo-text span { color: var(--ks-foot-emerald); }
  .ks-foot-desc { font-size: 0.95rem; line-height: 1.7; margin: 0; }

  /* Contact List */
  .ks-foot-contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .ks-foot-contact-item { display: flex; align-items: flex-start; gap: 12px; font-size: 0.9rem; line-height: 1.5; }
  .ks-foot-contact-item svg { width: 18px; height: 18px; color: var(--ks-foot-accent); margin-top: 3px; flex-shrink: 0; }

  /* Titles */
  .ks-foot-col-title {
    font-size: 1.1rem; font-weight: 800; color: var(--ks-foot-text-main); margin: 0 0 24px 0;
    position: relative; padding-bottom: 12px;
  }
  .ks-foot-col-title::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 40px; height: 3px;
    background: var(--ks-foot-accent); border-radius: 2px;
  }

  /* Menus */
  .ks-foot-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .ks-foot-links a {
    color: var(--ks-foot-text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500;
    transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px;
  }
  .ks-foot-links a::before {
    content: '→'; font-size: 0.8rem; color: var(--ks-foot-emerald); opacity: 0; transform: translateX(-5px); transition: all 0.3s ease;
  }
  .ks-foot-links a:hover { color: var(--ks-foot-accent); transform: translateX(4px); }
  .ks-foot-links a:hover::before { opacity: 1; transform: translateX(0); }

  /* Newsletter */
  .ks-newsletter-form { display: flex; position: relative; margin-top: 16px; }
  .ks-newsletter-input {
    width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--ks-foot-border);
    padding: 14px 16px; border-radius: 12px; color: white; font-size: 0.95rem; outline: none; transition: all 0.3s ease;
  }
  .ks-newsletter-input:focus { border-color: var(--ks-foot-emerald); background: rgba(255, 255, 255, 0.08); }
  .ks-newsletter-btn {
    position: absolute; right: 4px; top: 4px; bottom: 4px; background: var(--ks-foot-accent);
    color: #000; border: none; border-radius: 8px; padding: 0 20px; font-weight: 800; cursor: pointer; transition: all 0.3s ease;
  }
  .ks-newsletter-btn:hover { background: #f59e0b; transform: scale(0.98); }

  /* Social Icons */
  .ks-social-flex { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .ks-social-icon {
    width: 40px; height: 40px; border-radius: 50%; background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--ks-foot-border); display: flex; align-items: center; justify-content: center;
    color: var(--ks-foot-text-main); text-decoration: none; transition: all 0.3s ease;
  }
  .ks-social-icon svg { width: 18px; height: 18px; fill: currentColor; }
  .ks-social-icon:hover { background: var(--ks-foot-emerald); border-color: var(--ks-foot-emerald); color: white; transform: translateY(-3px); }

  /* Bottom Bar */
  .ks-foot-bottom { background: var(--ks-foot-bg-bottom); border-top: 1px solid var(--ks-foot-border); padding: 24px 20px; }
  .ks-foot-bottom-container { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; }
  @media (min-width: 768px) {
    .ks-foot-bottom-container { flex-direction: row; justify-content: space-between; text-align: left; }
  }
  .ks-copyright { font-size: 0.85rem; color: var(--ks-foot-text-muted); margin: 0; }
  .ks-payment-icons { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .ks-payment-icons svg { height: 24px; width: 38px; opacity: 0.8; }
{%- endstyle -%}

<footer class="ks-footer-wrapper">
  <div class="ks-footer-container">
    <div class="ks-foot-grid">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'brand_contact' -%}
            <div class="ks-foot-brand" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-width: {{ block.settings.logo_width }}px; height: auto;">
              {%- else -%}
                <a href="{{ routes.root_url }}" class="ks-foot-logo">
                  <div class="ks-foot-logo-icon">🌱</div>
                  <div class="ks-foot-logo-text">{{ shop.name }}</div>
                </a>
              {%- endif -%}
              
              {%- if block.settings.description != blank -%}
                <p class="ks-foot-desc">{{ block.settings.description }}</p>
              {%- endif -%}

              <ul class="ks-foot-contact-list">
                {%- if block.settings.address != blank -%}
                  <li class="ks-foot-contact-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span>{{ block.settings.address }}</span>
                  </li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li class="ks-foot-contact-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    <span><strong>Helpline:</strong> <a href="tel:{{ block.settings.phone }}" style="color: inherit; text-decoration: none;">{{ block.settings.phone }}</a></span>
                  </li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li class="ks-foot-contact-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    <a href="mailto:{{ block.settings.email }}" style="color: inherit; text-decoration: none;">{{ block.settings.email }}</a>
                  </li>
                {%- endif -%}
              </ul>
            </div>

          {%- when 'link_list' -%}
            <div class="ks-foot-col" {{ block.shopify_attributes }}>
              <h4 class="ks-foot-col-title">{{ block.settings.heading | default: block.settings.menu.title }}</h4>
              {%- if block.settings.menu != blank -%}
                <ul class="ks-foot-links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="ks-foot-col" {{ block.shopify_attributes }}>
              <h4 class="ks-foot-col-title">{{ block.settings.heading }}</h4>
              <div class="ks-foot-newsletter">
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.6;">{{ block.settings.subtext }}</p>
                
                {%- form 'customer', id: 'ContactFooter', class: 'contact-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="ks-newsletter-form">
                    <input type="email" name="contact[email]" class="ks-newsletter-input" placeholder="Enter your email..." required>
                    <button type="submit" class="ks-newsletter-btn">Join</button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    <p style="color: var(--ks-foot-emerald); font-size: 0.85rem; margin-top: 8px;">Thanks for subscribing!</p>
                  {%- endif -%}
                {%- endform -%}

                {%- if block.settings.show_social -%}
                  <div class="ks-social-flex">
                    {%- if settings.social_facebook_link != blank -%}
                      <a href="{{ settings.social_facebook_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
                    {%- endif -%}
                    {%- if settings.social_instagram_link != blank -%}
                      <a href="{{ settings.social_instagram_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
                    {%- endif -%}
                    {%- if settings.social_youtube_link != blank -%}
                      <a href="{{ settings.social_youtube_link }}" target="_blank" class="ks-social-icon"><svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.16 1 12 1 12s0 3.84.46 5.58a2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.84 23 12 23 12s0-3.84-.46-5.58zM9.5 15.5v-7l6.5 3.5-6.5 3.5z"></path></svg></a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}

    </div>
  </div>

  <div class="ks-foot-bottom">
    <div class="ks-foot-bottom-container">
      <p class="ks-copyright">
        &copy; {{ 'now' | date: '%Y' }} <strong>{{ shop.name }}</strong>. {{ section.settings.copyright_text }}
      </p>
      
      {%- if section.settings.payment_enable -%}
        <div class="ks-payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#051a11"
    },
    {
      "type": "color",
      "id": "bg_bottom_color",
      "label": "Bottom Bar Background",
      "default": "#03100a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#94a3b8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Gold)",
      "default": "#fbbf24"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All Rights Reserved."
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "brand_contact",
      "name": "Brand & Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Custom Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 250,
          "step": 10,
          "unit": "px",
          "label": "Logo Width",
          "default": 150
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "बिहार का नं. 1 और सबसे भरोसेमंद कृषि ई-कॉमर्स प्लेटफॉर्म। किसानों को 100% असली बीज, खाद और मशीनरी सीधे घर तक पहुँचाने का संकल्प।"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "Exhibition Road, Patna, Bihar - 800001, India"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Helpline",
          "default": "1800-123-4567"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email Support",
          "default": "support@krishisathi.in"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the menu title."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter & Socials",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Join Our Community"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Description",
          "default": "मौसम, नई फसल तकनीक और एक्सक्लूसिव डिस्काउंट की जानकारी सबसे पहले पाएं।"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show Social Media Icons",
          "default": true
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "brand_contact"
      },
      {
        "type": "link_list"
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}