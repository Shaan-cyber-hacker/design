    "custom_liquid_CrFYni": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================================================\n     KRISHISATHI - PREMIUM HERO CAROUSEL (CUSTOM LIQUID VERSION)\n     ========================================================================== */\n  .ks-cl-hero-section {\n    position: relative;\n    width: 100%;\n    height: 80vh;\n    min-height: 550px;\n    max-height: 800px;\n    overflow: hidden;\n    background-color: #08281a;\n    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;\n  }\n\n  @media (max-width: 767px) {\n    .ks-cl-hero-section {\n      height: 85vh; \n      min-height: 600px;\n    }\n  }\n\n  /* --- Slider Track & Slides --- */\n  .ks-cl-slide {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), visibility 1s;\n    z-index: 1;\n  }\n\n  .ks-cl-slide.is-active {\n    opacity: 1;\n    visibility: visible;\n    z-index: 2;\n  }\n\n  /* --- Image Handling & Cinematic Zoom (Ken Burns) --- */\n  .ks-cl-bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    transform: scale(1);\n    transition: transform 7s linear;\n  }\n\n  .ks-cl-slide.is-active .ks-cl-bg {\n    transform: scale(1.08);\n  }\n\n  /* Desktop vs Mobile Image Toggle */\n  .ks-cl-bg.mobile-img { display: none; }\n  \n  @media (max-width: 767px) {\n    .ks-cl-bg.desktop-img { display: none; }\n    .ks-cl-bg.mobile-img { display: block; }\n  }\n\n  /* --- Dark Gradient Overlay --- */\n  .ks-cl-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to right, rgba(8, 40, 26, 0.85) 0%, rgba(8, 40, 26, 0.4) 50%, rgba(0,0,0,0) 100%);\n    z-index: 2;\n  }\n\n  @media (max-width: 767px) {\n    .ks-cl-overlay {\n      background: linear-gradient(to top, rgba(8, 40, 26, 0.95) 0%, rgba(8, 40, 26, 0.5) 60%, rgba(0,0,0,0.1) 100%);\n    }\n  }\n\n  /* --- Content & Glassmorphism Box --- */\n  .ks-cl-content-wrapper {\n    position: absolute;\n    inset: 0;\n    z-index: 3;\n    display: flex;\n    align-items: center;\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  @media (max-width: 767px) {\n    .ks-cl-content-wrapper {\n      align-items: flex-end;\n      padding: 0 16px 80px 16px;\n    }\n  }\n\n  .ks-cl-glass-box {\n    background: rgba(255, 255, 255, 0.08);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    border-radius: 24px;\n    padding: 40px;\n    max-width: 600px;\n    transform: translateY(30px);\n    opacity: 0;\n    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, opacity 1s ease 0.3s;\n    box-shadow: 0 20px 40px rgba(0,0,0,0.2);\n  }\n\n  @media (max-width: 767px) {\n    .ks-cl-glass-box {\n      padding: 28px 24px;\n      max-width: 100%;\n      width: 100%;\n    }\n  }\n\n  .ks-cl-slide.is-active .ks-cl-glass-box {\n    transform: translateY(0);\n    opacity: 1;\n  }\n\n  /* --- Typography --- */\n  .ks-cl-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(251, 191, 36, 0.15);\n    color: #fbbf24;\n    border: 1px solid rgba(251, 191, 36, 0.3);\n    padding: 6px 14px;\n    border-radius: 50px;\n    font-size: 0.8rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 20px;\n  }\n\n  .ks-cl-badge-dot {\n    width: 6px;\n    height: 6px;\n    background: #fbbf24;\n    border-radius: 50%;\n    box-shadow: 0 0 8px #fbbf24;\n    animation: ks-cl-blink 2s infinite;\n  }\n\n  @keyframes ks-cl-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }\n\n  .ks-cl-heading {\n    font-size: clamp(2.2rem, 5vw, 3.8rem);\n    font-weight: 900;\n    color: #ffffff;\n    line-height: 1.15;\n    margin: 0 0 16px 0;\n    letter-spacing: -0.02em;\n    text-shadow: 0 2px 10px rgba(0,0,0,0.3);\n  }\n\n  .ks-cl-subheading {\n    font-size: clamp(1rem, 2vw, 1.15rem);\n    color: #e2e8f0;\n    line-height: 1.6;\n    margin: 0 0 32px 0;\n    font-weight: 500;\n  }\n\n  /* --- CTA Button --- */\n  .ks-cl-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);\n    color: #08281a;\n    padding: 16px 32px;\n    border-radius: 14px;\n    font-size: 1.05rem;\n    font-weight: 800;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    box-shadow: 0 10px 20px rgba(245, 158, 11, 0.3);\n  }\n\n  .ks-cl-btn:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 15px 25px rgba(245, 158, 11, 0.4);\n    background: linear-gradient(135deg, #fcd34d 0%, #fbbf24 100%);\n  }\n\n  /* --- Navigation Dots --- */\n  .ks-cl-dots {\n    position: absolute;\n    bottom: 30px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 10;\n    display: flex;\n    gap: 12px;\n    background: rgba(0,0,0,0.3);\n    padding: 10px 16px;\n    border-radius: 50px;\n    backdrop-filter: blur(8px);\n  }\n\n  .ks-cl-dot {\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.4);\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n\n  .ks-cl-dot.is-active {\n    background: #fbbf24;\n    width: 24px;\n    border-radius: 10px;\n  }\n</style>\n\n<section id=\"ks-custom-hero-carousel\" class=\"ks-cl-hero-section\">\n  \n  <div class=\"ks-cl-slides-container\">\n    \n    <!-- SLIDE 1: Seeds -->\n    <div class=\"ks-cl-slide is-active\">\n      <!-- Change the src URLs below to your Shopify image URLs -->\n      <img src=\"https://images.unsplash.com/photo-1592982537447-6f2a6a0c6c1b?q=80&w=2000&auto=format&fit=crop\" alt=\"Paddy Seeds\" class=\"ks-cl-bg desktop-img\">\n      <img src=\"https://images.unsplash.com/photo-1592982537447-6f2a6a0c6c1b?q=80&w=800&h=1200&auto=format&fit=crop\" alt=\"Paddy Seeds Mobile\" class=\"ks-cl-bg mobile-img\">\n      \n      <div class=\"ks-cl-overlay\"></div>\n      \n      <div class=\"ks-cl-content-wrapper\">\n        <div class=\"ks-cl-glass-box\">\n          <div class=\"ks-cl-badge\">\n            <span class=\"ks-cl-badge-dot\"></span>\n            Trusted by 50,000+ Farmers\n          </div>\n          <h2 class=\"ks-cl-heading\">Premium Hybrid Seeds<br>Delivered Home</h2>\n          <p class=\"ks-cl-subheading\">Boost your yield with our 100% certified and original crop seeds. Guaranteed cash on delivery across Bihar.</p>\n          <a href=\"/collections/seeds\" class=\"ks-cl-btn\">\n            Shop Seeds\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 2: Crop Protection -->\n    <div class=\"ks-cl-slide\">\n      <img src=\"https://images.unsplash.com/photo-1628185012558-de20b8eb97e8?q=80&w=2000&auto=format&fit=crop\" alt=\"Crop Protection\" class=\"ks-cl-bg desktop-img\">\n      <img src=\"https://images.unsplash.com/photo-1628185012558-de20b8eb97e8?q=80&w=800&h=1200&auto=format&fit=crop\" alt=\"Crop Protection Mobile\" class=\"ks-cl-bg mobile-img\">\n      \n      <div class=\"ks-cl-overlay\"></div>\n      \n      <div class=\"ks-cl-content-wrapper\">\n        <div class=\"ks-cl-glass-box\">\n          <div class=\"ks-cl-badge\">\n            <span class=\"ks-cl-badge-dot\"></span>\n            Fast Delivery in 38 Districts\n          </div>\n          <h2 class=\"ks-cl-heading\">Advanced Crop<br>Protection</h2>\n          <p class=\"ks-cl-subheading\">Save your crops from pests and diseases. Buy 100% original company bio-pesticides and fungicides with GST invoice.</p>\n          <a href=\"/collections/crop-protection\" class=\"ks-cl-btn\">\n            Explore Medicines\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 3: Fertilizers -->\n    <div class=\"ks-cl-slide\">\n      <img src=\"https://images.unsplash.com/photo-1464226184884-fa280b87c399?q=80&w=2000&auto=format&fit=crop\" alt=\"Organic Fertilizer\" class=\"ks-cl-bg desktop-img\">\n      <img src=\"https://images.unsplash.com/photo-1464226184884-fa280b87c399?q=80&w=800&h=1200&auto=format&fit=crop\" alt=\"Organic Fertilizer Mobile\" class=\"ks-cl-bg mobile-img\">\n      \n      <div class=\"ks-cl-overlay\"></div>\n      \n      <div class=\"ks-cl-content-wrapper\">\n        <div class=\"ks-cl-glass-box\">\n          <div class=\"ks-cl-badge\">\n            <span class=\"ks-cl-badge-dot\"></span>\n            Free Agri-Doctor Advice\n          </div>\n          <h2 class=\"ks-cl-heading\">Maximum Yield &<br>Healthy Growth</h2>\n          <p class=\"ks-cl-subheading\">Improve soil health and plant roots with our premium range of micronutrients, tonics, and nano fertilizers.</p>\n          <a href=\"/collections/fertilizers\" class=\"ks-cl-btn\">\n            Shop Fertilizers\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Pagination Dots -->\n  <div class=\"ks-cl-dots\">\n    <div class=\"ks-cl-dot is-active\" data-index=\"0\"></div>\n    <div class=\"ks-cl-dot\" data-index=\"1\"></div>\n    <div class=\"ks-cl-dot\" data-index=\"2\"></div>\n  </div>\n\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const heroSection = document.getElementById('ks-custom-hero-carousel');\n    if (!heroSection) return;\n\n    const slides = heroSection.querySelectorAll('.ks-cl-slide');\n    const dots = heroSection.querySelectorAll('.ks-cl-dot');\n    const autoplaySpeed = 6000; // 6 seconds per slide\n    let currentSlide = 0;\n    let slideInterval;\n\n    function goToSlide(index) {\n      slides[currentSlide].classList.remove('is-active');\n      dots[currentSlide].classList.remove('is-active');\n      \n      currentSlide = index;\n      \n      slides[currentSlide].classList.add('is-active');\n      dots[currentSlide].classList.add('is-active');\n    }\n\n    function nextSlide() {\n      const next = (currentSlide + 1) % slides.length;\n      goToSlide(next);\n    }\n\n    function startAutoplay() {\n      slideInterval = setInterval(nextSlide, autoplaySpeed);\n    }\n\n    function stopAutoplay() {\n      clearInterval(slideInterval);\n    }\n\n    // Dot Click Logic\n    dots.forEach((dot, index) => {\n      dot.addEventListener('click', () => {\n        stopAutoplay();\n        goToSlide(index);\n        startAutoplay();\n      });\n    });\n\n    // Touch Swipe Logic for Mobile\n    let touchstartX = 0;\n    let touchendX = 0;\n    \n    heroSection.addEventListener('touchstart', e => {\n      touchstartX = e.changedTouches[0].screenX;\n      stopAutoplay();\n    }, {passive: true});\n    \n    heroSection.addEventListener('touchend', e => {\n      touchendX = e.changedTouches[0].screenX;\n      if (touchendX < touchstartX - 50) nextSlide(); // Swipe Left\n      if (touchendX > touchstartX + 50) { // Swipe Right\n        const prev = (currentSlide - 1 + slides.length) % slides.length;\n        goToSlide(prev);\n      }\n      startAutoplay();\n    }, {passive: true});\n\n    // Start carousel\n    startAutoplay();\n  });\n</script>",
