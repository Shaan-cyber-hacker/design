    "custom_liquid_rpBnzb": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================================================\n     KRISHISATHI - PREMIUM FAQ SECTION (CUSTOM LIQUID / HTML)\n     ========================================================================== */\n  .ks-faq-section {\n    --ks-p-dark: #08281a;\n    --ks-p-main: #134e32;\n    --ks-gold: #fbbf24;\n    --ks-bg-soft: #f8faf8;\n    --ks-border: #e2e8f0;\n    --ks-text-main: #1f2937;\n    --ks-text-muted: #4b5563;\n    \n    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;\n    background-color: var(--ks-bg-soft);\n    padding: 72px 16px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Decorative Background Glow */\n  .ks-faq-section::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 100%;\n    max-width: 800px;\n    height: 400px;\n    background: radial-gradient(circle, rgba(16, 185, 129, 0.05) 0%, rgba(255,255,255,0) 70%);\n    pointer-events: none;\n  }\n\n  .ks-faq-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n  }\n\n  /* Header Styles */\n  .ks-faq-header {\n    text-align: center;\n    max-width: 700px;\n    margin: 0 auto 48px auto;\n  }\n\n  .ks-faq-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #ecfdf5;\n    color: var(--ks-p-main);\n    border: 1px solid #a7f3d0;\n    padding: 6px 18px;\n    border-radius: 50px;\n    font-size: 0.85rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-bottom: 16px;\n  }\n\n  .ks-faq-title {\n    font-size: clamp(2rem, 4vw, 2.8rem);\n    font-weight: 900;\n    color: var(--ks-p-dark);\n    line-height: 1.2;\n    margin: 0 0 16px 0;\n    letter-spacing: -0.02em;\n  }\n\n  .ks-faq-title span {\n    color: var(--ks-p-main);\n    position: relative;\n  }\n  \n  .ks-faq-title span::after {\n    content: '';\n    position: absolute;\n    bottom: 4px;\n    left: 0;\n    width: 100%;\n    height: 6px;\n    background: rgba(251, 191, 36, 0.4);\n    z-index: -1;\n    border-radius: 4px;\n  }\n\n  .ks-faq-subtitle {\n    font-size: 1.05rem;\n    color: var(--ks-text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* FAQ Grid (2 Columns on Desktop) */\n  .ks-faq-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 16px 24px;\n    align-items: start;\n  }\n\n  @media (min-width: 992px) {\n    .ks-faq-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  /* Individual Accordion Item */\n  .ks-faq-item {\n    background: #ffffff;\n    border: 1px solid var(--ks-border);\n    border-radius: 16px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.02);\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .ks-faq-item:hover {\n    border-color: rgba(19, 78, 50, 0.2);\n    box-shadow: 0 8px 25px rgba(19, 78, 50, 0.06);\n  }\n\n  .ks-faq-item.is-open {\n    border-color: var(--ks-p-main);\n    box-shadow: 0 8px 25px rgba(19, 78, 50, 0.08);\n  }\n\n  /* Question Button */\n  .ks-faq-question {\n    width: 100%;\n    text-align: left;\n    padding: 20px 24px;\n    background: transparent;\n    border: none;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 1.05rem;\n    font-weight: 700;\n    color: var(--ks-p-dark);\n    gap: 16px;\n    transition: color 0.3s ease;\n  }\n\n  .ks-faq-item.is-open .ks-faq-question {\n    color: var(--ks-p-main);\n  }\n\n  /* Plus/Minus Icon */\n  .ks-faq-icon {\n    flex-shrink: 0;\n    width: 24px;\n    height: 24px;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    background: #f1f5f9;\n    color: var(--ks-p-main);\n    transition: all 0.3s ease;\n  }\n\n  .ks-faq-item.is-open .ks-faq-icon {\n    background: var(--ks-p-main);\n    color: #ffffff;\n    transform: rotate(180deg);\n  }\n\n  .ks-faq-icon::before,\n  .ks-faq-icon::after {\n    content: '';\n    position: absolute;\n    background-color: currentColor;\n    border-radius: 2px;\n    transition: transform 0.3s ease;\n  }\n\n  /* Horizontal line (Minus) */\n  .ks-faq-icon::before {\n    width: 12px;\n    height: 2px;\n  }\n\n  /* Vertical line (Plus) */\n  .ks-faq-icon::after {\n    width: 2px;\n    height: 12px;\n  }\n\n  /* Hide vertical line when open */\n  .ks-faq-item.is-open .ks-faq-icon::after {\n    transform: scaleY(0);\n  }\n\n  /* Answer Container */\n  .ks-faq-answer-wrapper {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .ks-faq-answer {\n    padding: 0 24px 24px 24px;\n    font-size: 0.95rem;\n    color: var(--ks-text-muted);\n    line-height: 1.6;\n  }\n\n  /* Bottom Help CTA */\n  .ks-faq-footer {\n    margin-top: 56px;\n    text-align: center;\n    background: linear-gradient(135deg, #134e32 0%, #08281a 100%);\n    border-radius: 20px;\n    padding: 32px 24px;\n    color: #ffffff;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 16px;\n    box-shadow: 0 15px 30px rgba(8, 40, 26, 0.15);\n  }\n\n  .ks-faq-footer h4 {\n    font-size: 1.3rem;\n    font-weight: 800;\n    margin: 0;\n    color: var(--ks-gold);\n  }\n\n  .ks-faq-footer p {\n    font-size: 0.95rem;\n    margin: 0;\n    color: #d1fae5;\n    max-width: 500px;\n  }\n\n  .ks-faq-actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 12px;\n    margin-top: 8px;\n  }\n\n  .ks-btn-whatsapp {\n    background: #10b981;\n    color: #ffffff;\n    font-weight: 700;\n    padding: 12px 24px;\n    border-radius: 12px;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    transition: all 0.3s ease;\n  }\n\n  .ks-btn-whatsapp:hover {\n    background: #059669;\n    transform: translateY(-2px);\n  }\n\n  .ks-btn-call {\n    background: rgba(255,255,255,0.1);\n    color: #ffffff;\n    font-weight: 700;\n    padding: 12px 24px;\n    border-radius: 12px;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid rgba(255,255,255,0.2);\n    transition: all 0.3s ease;\n  }\n\n  .ks-btn-call:hover {\n    background: rgba(255,255,255,0.2);\n  }\n</style>\n\n<section class=\"ks-faq-section\">\n  <div class=\"ks-faq-container\">\n    \n    <!-- Section Header -->\n    <div class=\"ks-faq-header\">\n      <div class=\"ks-faq-badge\">Help Center</div>\n      <h2 class=\"ks-faq-title\">Frequently Asked <span>Questions</span></h2>\n      <p class=\"ks-faq-subtitle\">Find quick answers to your questions regarding orders, shipping, returns, and account management below.</p>\n    </div>\n\n    <!-- FAQ Grid Layout -->\n    <div class=\"ks-faq-grid\">\n      \n      <!-- COLUMN 1 -->\n      <div class=\"ks-faq-col\">\n        \n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Cancel The Order That I Placed?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              You can easily cancel your order from the 'My Orders' section in your account before it is dispatched. If the order has already been shipped, please contact our customer support immediately to refuse the delivery.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Create A Return Request?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Go to 'My Account', select 'My Orders', click on the specific item, and select 'Return'. You can return damaged, defective, or incorrect products within our specified return window (usually 7 days).\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Check The Status Of My Order?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              You can track your order in real-time by visiting the 'Track Order' page or checking the 'My Orders' section. We also send SMS and WhatsApp updates at every stage of your delivery.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            Why There Is A Difference In Selling Price On KrishiSathi And Local Shops?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              We source directly from certified manufacturers and company warehouses. By eliminating local middlemen and distributors, we are able to pass those cost savings directly to you, ensuring better prices and 100% original products.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            Does KrishiSathi Deliver Products Outside The Country?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Currently, we do not deliver outside of India. We are strictly focused on empowering local farmers and currently provide express delivery across all 38 districts of Bihar.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Get My Order Delivered Faster?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              We automatically dispatch all orders within 24 hours. For critical agricultural needs (like urgent pesticides), please call our toll-free helpline after placing the order, and we will try to prioritize your shipment.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            I Received A Partial Item/Order Or Void Packet. What To Do?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              We sincerely apologize for the inconvenience. Please contact our support team within 24 hours of delivery. We highly recommend recording a quick unboxing video to process your replacement or refund instantly.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            Can I Modify My Order Shipping Address?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Yes, you can modify the shipping address only if your order has not been dispatched yet. Please call our customer care helpline immediately to request the address change.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            When Will I Receive My Refund For The Order I Cancelled?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              For prepaid orders, the refund is initiated immediately upon cancellation and usually reflects in your original bank account or UPI within 5 to 7 business days.\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            Can My Order Be Replaced?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Yes! If you receive a damaged, expired, or incorrect agricultural product, we offer a hassle-free replacement. Just raise a request from your account or contact our helpline.\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- COLUMN 2 -->\n      <div class=\"ks-faq-col\">\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Create An Account On KrishiSathi?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Click on the profile icon at the top right of the website. Select 'Create Account' or 'Sign Up', enter your mobile number and name, verify with the OTP, and your account will be ready instantly!\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How Do I Login If I Lost My Registered Phone Number?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              If you have registered an email ID with us, you can log in using your email and password. If not, please contact our customer support team to help recover and update your account details.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            After Entering OTP, Why Am I Asked For Password?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              This is a standard security measure to ensure the absolute safety of your account, order history, and saved addresses. You can easily reset the password if you don't remember it.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How Do I Get New Password For My Account?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Go to the login page and click on 'Forgot Password'. Enter your registered email address or phone number, and we will send you a secure link or OTP to create a new password.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            Where Is KrishiSathi Located?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              KrishiSathi (Agrotix Bio Harvest Pvt. Ltd.) is proudly headquartered in Patna, Bihar. We operate regional fulfillment centers across the state to ensure fast delivery to every village.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How Does COD (Cash On Delivery) Work?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Cash on Delivery allows you to order products without paying online. When the delivery executive brings the product to your home or farm, you can inspect the package and pay them in cash.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            What Is The Limit Of COD?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              Currently, the maximum order value for Cash on Delivery is ₹10,000 per order. For bulk agricultural purchases exceeding this amount, please use our secure prepaid online payment options.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            How To Apply A Coupon Code On The Order?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              When you proceed to checkout, you will see a box labeled 'Discount Code' or 'Gift Card'. Type your coupon code there and click 'Apply'. The total amount will be updated instantly.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ks-faq-item\">\n          <button class=\"ks-faq-question\">\n            I Was Given A Coupon From A Cancelled Order. How Can I Use It?\n            <span class=\"ks-faq-icon\"></span>\n          </button>\n          <div class=\"ks-faq-answer-wrapper\">\n            <div class=\"ks-faq-answer\">\n              You can treat this exactly like a standard discount code. Simply enter the coupon code in the 'Discount Code' box during the checkout process of your next purchase to redeem your balance.\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- Bottom Help CTA -->\n    <div class=\"ks-faq-footer\">\n      <h4>Still have doubts?</h4>\n      <p>Our agricultural experts are ready to assist you. Call us or send a message on WhatsApp for instant support.</p>\n      \n      <div class=\"ks-faq-actions\">\n        <a href=\"https://wa.me/917870647015?text=नमस्ते%20कृषिसाथी\" target=\"_blank\" class=\"ks-btn-whatsapp\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n          Chat on WhatsApp\n        </a>\n        <a href=\"tel:917870647015\" class=\"ks-btn-call\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n          Call Helpline\n        </a>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<!-- Accordion JavaScript Engine -->\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const faqItems = document.querySelectorAll('.ks-faq-item');\n\n    faqItems.forEach(item => {\n      const button = item.querySelector('.ks-faq-question');\n      const answerWrapper = item.querySelector('.ks-faq-answer-wrapper');\n\n      button.addEventListener('click', () => {\n        const isOpen = item.classList.contains('is-open');\n\n        // Optional: Close all other accordions when one is opened\n        /*\n        faqItems.forEach(otherItem => {\n          otherItem.classList.remove('is-open');\n          otherItem.querySelector('.ks-faq-answer-wrapper').style.maxHeight = null;\n        });\n        */\n\n        // Toggle the clicked item\n        if (isOpen) {\n          item.classList.remove('is-open');\n          answerWrapper.style.maxHeight = null;\n        } else {\n          item.classList.add('is-open');\n          answerWrapper.style.maxHeight = answerWrapper.scrollHeight + \"px\";\n        }\n      });\n    });\n  });\n</script>",
