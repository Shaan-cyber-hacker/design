    "custom_liquid_kLHUzA": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================================================\n     KRISHISATHI - INTERACTIVE SOCIAL PRESENCE (CUSTOM LIQUID)\n     Features: Glassmorphism, Animated Blobs, 3D Hover Effects\n     ========================================================================== */\n  .ks-custom-social {\n    /* Color & Gradient Variables */\n    --ks-bg-color: #f8faf8;\n    --ks-heading-color: #08281a;\n    --ks-text-muted: #475569;\n    --ks-ig-grad-1: #f09433;\n    --ks-ig-grad-2: #dc2743;\n    --ks-ig-grad-3: #bc1888;\n    --ks-ig-gradient: linear-gradient(45deg, var(--ks-ig-grad-1) 0%, var(--ks-ig-grad-2) 50%, var(--ks-ig-grad-3) 100%);\n    \n    /* Layout */\n    --ks-padding-y: 80px;\n    \n    position: relative;\n    padding: var(--ks-padding-y) 16px;\n    background-color: var(--ks-bg-color);\n    overflow: hidden;\n    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;\n  }\n\n  /* --- Animated Background Blobs --- */\n  .ks-social-bg-blobs {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 0;\n    overflow: hidden;\n  }\n\n  .ks-blob {\n    position: absolute;\n    filter: blur(80px);\n    opacity: 0.15;\n    border-radius: 50%;\n    animation: ks-float 12s infinite alternate ease-in-out;\n  }\n\n  .ks-blob-1 {\n    top: -10%;\n    left: -5%;\n    width: 400px;\n    height: 400px;\n    background: var(--ks-ig-grad-2);\n    animation-delay: 0s;\n  }\n\n  .ks-blob-2 {\n    bottom: -10%;\n    right: -5%;\n    width: 500px;\n    height: 500px;\n    background: var(--ks-ig-grad-1);\n    animation-delay: -5s;\n  }\n\n  .ks-blob-3 {\n    top: 40%;\n    left: 50%;\n    width: 300px;\n    height: 300px;\n    background: var(--ks-ig-grad-3);\n    animation-delay: -2s;\n  }\n\n  @keyframes ks-float {\n    0% { transform: translate(0, 0) scale(1); }\n    50% { transform: translate(50px, 30px) scale(1.1); }\n    100% { transform: translate(-30px, 50px) scale(0.9); }\n  }\n\n  /* --- Main Container --- */\n  .ks-social-container {\n    position: relative;\n    z-index: 2;\n    max-width: 1280px;\n    margin: 0 auto;\n  }\n\n  /* --- Header (Glassmorphic) --- */\n  .ks-social-header {\n    text-align: center;\n    max-width: 700px;\n    margin: 0 auto 48px auto;\n    background: rgba(255, 255, 255, 0.6);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.8);\n    padding: 32px 24px;\n    border-radius: 24px;\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);\n  }\n\n  .ks-social-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--ks-ig-gradient);\n    padding: 6px 16px;\n    border-radius: 50px;\n    color: white;\n    font-size: 13px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 16px;\n    box-shadow: 0 8px 20px rgba(220, 39, 67, 0.25);\n  }\n\n  .ks-social-title {\n    font-size: clamp(28px, 4vw, 42px);\n    font-weight: 900;\n    color: var(--ks-heading-color);\n    line-height: 1.2;\n    margin: 0 0 12px 0;\n  }\n\n  .ks-social-title span {\n    background: var(--ks-ig-gradient);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    display: inline-block;\n  }\n\n  .ks-social-subtitle {\n    font-size: 16px;\n    color: var(--ks-text-muted);\n    line-height: 1.6;\n    margin: 0;\n    font-weight: 500;\n  }\n\n  /* --- Interactive Grid --- */\n  .ks-social-grid {\n    display: flex;\n    gap: 24px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    padding: 20px 10px 40px 10px; /* Padding for hover shadows */\n    -ms-overflow-style: none;  \n    scrollbar-width: none;  \n  }\n\n  .ks-social-grid::-webkit-scrollbar {\n    display: none; \n  }\n\n  @media (min-width: 768px) {\n    .ks-social-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      overflow-x: visible;\n      padding: 20px 0 40px 0;\n    }\n  }\n\n  @media (min-width: 1024px) {\n    .ks-social-grid {\n      grid-template-columns: repeat(4, 1fr);\n    }\n  }\n\n  /* --- 3D Hover Post Wrappers --- */\n  .ks-ig-embed-wrapper {\n    min-width: 320px;\n    width: 100%;\n    flex-shrink: 0;\n    scroll-snap-align: center;\n    background: #ffffff;\n    border-radius: 20px;\n    padding: 16px;\n    /* Smooth Shadows & Transitions */\n    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    border: 1px solid rgba(0,0,0,0.03);\n    position: relative;\n    z-index: 1;\n  }\n\n  /* The magic hover effect */\n  .ks-ig-embed-wrapper:hover {\n    transform: translateY(-12px) scale(1.02);\n    box-shadow: 0 30px 50px -10px rgba(220, 39, 67, 0.25);\n    z-index: 10;\n    border-color: rgba(220, 39, 67, 0.1);\n  }\n\n  /* Inner wrapper to contain the native iframe neatly */\n  .ks-ig-inner {\n    border-radius: 12px;\n    overflow: hidden;\n    background: #fafafa;\n    /* Enforce a minimum height while it loads to prevent layout shifts */\n    min-height: 400px; \n    display: flex;\n    justify-content: center;\n  }\n\n  /* Mobile Swipe Hint */\n  .ks-swipe-hint {\n    text-align: center;\n    font-size: 13px;\n    color: var(--ks-text-muted);\n    font-weight: 700;\n    margin-top: -10px;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    animation: ks-swipe-pulse 2s infinite;\n  }\n\n  @media (min-width: 768px) {\n    .ks-swipe-hint {\n      display: none;\n    }\n  }\n\n  @keyframes ks-swipe-pulse {\n    0%, 100% { opacity: 0.5; transform: translateX(0); }\n    50% { opacity: 1; transform: translateX(5px); }\n  }\n\n  /* --- Animated CTA Button --- */\n  .ks-social-footer {\n    text-align: center;\n    margin-top: 10px;\n  }\n\n  .ks-master-ig-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: var(--ks-ig-gradient);\n    color: #ffffff;\n    padding: 16px 40px;\n    border-radius: 50px;\n    font-size: 17px;\n    font-weight: 800;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    box-shadow: 0 10px 20px -5px rgba(220, 39, 67, 0.4);\n    position: relative;\n    overflow: hidden;\n    z-index: 1;\n  }\n\n  /* Button Pulse Glow */\n  .ks-master-ig-btn::before {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    border-radius: 50px;\n    background: var(--ks-ig-gradient);\n    z-index: -1;\n    filter: blur(12px);\n    opacity: 0.6;\n    animation: ks-btn-pulse 2s infinite alternate;\n  }\n\n  @keyframes ks-btn-pulse {\n    0% { opacity: 0.4; transform: scale(1); }\n    100% { opacity: 0.8; transform: scale(1.05); }\n  }\n\n  .ks-master-ig-btn:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 15px 30px -5px rgba(220, 39, 67, 0.5);\n    color: #ffffff;\n  }\n\n  .ks-master-ig-btn svg {\n    width: 24px;\n    height: 24px;\n    fill: #ffffff;\n    transition: transform 0.3s ease;\n  }\n\n  .ks-master-ig-btn:hover svg {\n    transform: scale(1.1) rotate(5deg);\n  }\n</style>\n\n<section class=\"ks-custom-social\">\n  \n  <!-- Animated Background Elements -->\n  <div class=\"ks-social-bg-blobs\">\n    <div class=\"ks-blob ks-blob-1\"></div>\n    <div class=\"ks-blob ks-blob-2\"></div>\n    <div class=\"ks-blob ks-blob-3\"></div>\n  </div>\n\n  <div class=\"ks-social-container\">\n    \n    <!-- Glassmorphic Section Header -->\n    <div class=\"ks-social-header\">\n      <div class=\"ks-social-badge\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z\"/></svg>\n        Join Our Community\n      </div>\n\n      <h2 class=\"ks-social-title\">\n        Follow <span>Agrotix Bio Harvest</span>\n      </h2>\n\n      <p class=\"ks-social-subtitle\">\n        Join our growing family of farmers! Follow @agrotix_bio_harvest_pvt_ltd_ for live field results, exclusive updates, and modern farming techniques.\n      </p>\n    </div>\n\n    <!-- Mobile Swipe Hint -->\n    <div class=\"ks-swipe-hint\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n      Swipe to explore posts\n    </div>\n\n    <!-- Interactive Social Grid with Native Instagram Embeds -->\n    <div class=\"ks-social-grid\">\n      \n      <!-- Interactive 3D Wrapper 1 -->\n      <div class=\"ks-ig-embed-wrapper\">\n        <div class=\"ks-ig-inner\">\n          <blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/p/DYtkhSaPhs7/\" data-instgrm-version=\"14\" style=\"background:#FFF; border:0; margin:0; padding:0; width:100%;\"></blockquote>\n        </div>\n      </div>\n\n      <!-- Interactive 3D Wrapper 2 -->\n      <div class=\"ks-ig-embed-wrapper\">\n        <div class=\"ks-ig-inner\">\n          <blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/p/DaQs9ggh0Jc/\" data-instgrm-version=\"14\" style=\"background:#FFF; border:0; margin:0; padding:0; width:100%;\"></blockquote>\n        </div>\n      </div>\n\n      <!-- Interactive 3D Wrapper 3 -->\n      <div class=\"ks-ig-embed-wrapper\">\n        <div class=\"ks-ig-inner\">\n          <blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/p/DbYmnx_OKsr/\" data-instgrm-version=\"14\" style=\"background:#FFF; border:0; margin:0; padding:0; width:100%;\"></blockquote>\n        </div>\n      </div>\n\n      <!-- Interactive 3D Wrapper 4 -->\n      <div class=\"ks-ig-embed-wrapper\">\n        <div class=\"ks-ig-inner\">\n          <blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/p/DbnOAfevuv_/\" data-instgrm-version=\"14\" style=\"background:#FFF; border:0; margin:0; padding:0; width:100%;\"></blockquote>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Pulsing Animated Master CTA -->\n    <div class=\"ks-social-footer\">\n      <a href=\"https://www.instagram.com/agrotix_bio_harvest_pvt_ltd_\" target=\"_blank\" class=\"ks-master-ig-btn\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z\"/></svg>\n        Follow @agrotix_bio_harvest_pvt_ltd_\n      </a>\n    </div>\n\n  </div>\n  \n  <!-- Instagram Native API Script (Required for posts to load dynamically) -->\n  <script async src=\"//www.instagram.com/embed.js\"></script>\n</section>",
