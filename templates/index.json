d);\n    line-height: 1.55;\n    margin: 0 0 20px 0;\n    flex-grow: 1;\n  }\n\n  .ks-custom-op .ks-op-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 0.78rem;\n    font-weight: 800;\n    color: var(--ks-primary-accent);\n    background: var(--ks-badge-bg);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    padding: 6px 12px;\n    border-radius: 8px;\n    width: fit-content;\n  }\n\n  /* Bottom Trust Bar */\n  .ks-custom-op .ks-op-bottom-bar {\n    margin-top: 48px;\n    background: var(--ks-bottom-bg);\n    border-radius: 20px;\n    padding: 28px 32px;\n    color: #ffffff;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);\n    border: 1px solid rgba(251, 191, 36, 0.3);\n  }\n\n  @media (min-width: 768px) {\n    .ks-custom-op .ks-op-bottom-bar {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n  }\n\n  .ks-custom-op .ks-op-bar-content h4 {\n    font-size: 1.2rem;\n    font-weight: 800;\n    color: var(--ks-highlight-gold);\n    margin: 0 0 6px 0;\n  }\n\n  .ks-custom-op .ks-op-bar-content p {\n    font-size: 0.88rem;\n    color: rgba(255, 255, 255, 0.85);\n    margin: 0;\n    line-height: 1.5;\n  }\n\n  .ks-custom-op .ks-op-badges-flex {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  .ks-custom-op .ks-op-pill {\n    background: rgba(255, 255, 255, 0.12);\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    padding: 8px 16px;\n    border-radius: 50px;\n    font-size: 0.82rem;\n    font-weight: 700;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    white-space: nowrap;\n  }\n\n  .ks-custom-op .ks-op-pill span {\n    color: var(--ks-highlight-gold);\n  }\n</style>\n\n<section class=\"ks-custom-op\">\n  <div class=\"ks-op-container\">\n    \n    <!-- Section Header -->\n    <div class=\"ks-op-header\">\n      <div clas