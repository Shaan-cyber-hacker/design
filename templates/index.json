        "custom_liquid": "<style>\n  /* ==========================================================================\n     KRISHISATHI - WHY CHOOSE US SECTION (CUSTOM LIQUID VERSION - ENGLISH)\n     Simply modify any CSS variable below to customize colors, fonts, & sizes!\n     ========================================================================== */\n  .ks-custom-wcu {\n    /* Color Controls */\n    --ks-bg-color: #ffffff;               /* Section background color */\n    --ks-heading-color: #08281a;          /* Main heading color */\n    --ks-text-muted: #475569;             /* Body & subtitle text color */\n    --ks-primary-accent: #134e32;         /* Brand green accent color */\n    --ks-highlight-gold: #fbbf24;         /* Gold highlight underline color */\n    --ks-card-bg: #f8faf8;                /* Card background color */\n    --ks-card-border: #e2e8f0;            /* Card border color */\n    --ks-badge-bg: #ecfdf5;               /* Top badge background */\n    --ks-badge-text: #064e3b;             /* Top badge text color */\n    --ks-bottom-bg: #08281a;              /* Bottom banner background */\n    \n    /* Typography & Font Sizes */\n    --ks-title-size-mobile: 28px;         /* Heading size on Mobile */\n    --ks-title-size-desktop: 42px;        /* Heading size on Desktop */\n    --ks-subtitle-size: 16px;             /* Subtitle font size */\n    --ks-card-title-size: 18px;           /* Card title font size */\n    --ks-badge-font-size: 13px;           /* Badge font size */\n\n    /* Layout Spacing */\n    --ks-padding-top: 64px;               /* Section top spacing */\n    --ks-padding-bottom: 64px;            /* Section bottom spacing */\n    --ks-container-max: 1200px;           /* Max container width */\n\n    /* Base Setup */\n    padding-top: var(--ks-padding-top);\n    padding-bottom: var(--ks-padding-bottom);\n    background: var(--ks-bg-color);\n    color: var(--ks-heading-color);\n    font-family: inherit;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Container */\n  .ks-custom-wcu .ks-wcu-container {\n    max-width: var(--ks-container-max);\n    margin: 0 auto;\n    padding: 0 16px;\n    position: relative;\n    z-index: 2;\n  }\n\n  /* Section Header */\n  .ks-custom-wcu .ks-wcu-header {\n    text-align: center;\n    max-width: 780px;\n    margin: 0 auto 48px auto;\n  }\n\n  .ks-custom-wcu .ks-wcu-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--ks-badge-bg);\n    color: var(--ks-badge-text);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    padding: 6px 18px;\n    border-radius: 50px;\n    font-size: var(--ks-badge-font-size);\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-bottom: 16px;\n  }\n\n  .ks-custom-wcu .ks-wcu-badge-dot {\n    width: 8px;\n    height: 8px;\n    background-color: var(--ks-primary-accent);\n    border-radius: 50%;\n    animation: ks-wcu-pulse 2s infinite;\n  }\n\n  @keyframes ks-wcu-pulse {\n    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(19, 78, 50, 0.5); }\n    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(19, 78, 50, 0); }\n    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(19, 78, 50, 0); }\n  }\n\n  .ks-custom-wcu .ks-wcu-title {\n    font-size: var(--ks-title-size-mobile);\n    font-weight: 800;\n    color: var(--ks-heading-color);\n    line-height: 1.25;\n    margin: 0 0 14px 0;\n    letter-spacing: -0.02em;\n  }\n\n  @media (min-width: 768px) {\n    .ks-custom-wcu .ks-wcu-title {\n      font-size: var(--ks-title-size-desktop);\n    }\n  }\n\n  .ks-custom-wcu .ks-wcu-title span {\n    color: var(--ks-primary-accent);\n    position: relative;\n    display: inline-block;\n  }\n\n  .ks-custom-wcu .ks-wcu-title span::after {\n    content: '';\n    position: absolute;\n    bottom: 2px;\n    left: 0;\n    width: 100%;\n    height: 6px;\n    background: var(--ks-highlight-gold);\n    opacity: 0.45;\n    z-index: -1;\n    border-radius: 4px;\n  }\n\n  .ks-custom-wcu .ks-wcu-subtitle {\n    font-size: var(--ks-subtitle-size);\n    color: var(--ks-text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* Grid Layout */\n  .ks-custom-wcu .ks-wcu-grid {\n    display: grid;\n    grid-template-columns: repeat(1, 1fr);\n    gap: 24px;\n  }\n\n  @media (min-width: 640px) {\n    .ks-custom-wcu .ks-wcu-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (min-width: 1024px) {\n    .ks-custom-wcu .ks-wcu-grid {\n      grid-template-columns: repeat(4, 1fr);\n    }\n  }\n\n  /* Feature Cards */\n  .ks-custom-wcu .ks-wcu-card {\n    background: var(--ks-card-bg);\n    border: 1px solid var(--ks-card-border);\n    border-radius: 20px;\n    padding: 30px 22px;\n    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.03);\n    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex;\n    flex-direction: column;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .ks-custom-wcu .ks-wcu-card::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background: linear-gradient(90deg, var(--ks-primary-accent), var(--ks-highlight-gold));\n    opacity: 0;\n    transition: opacity 0.3s ease;\n  }\n\n  .ks-custom-wcu .ks-wcu-card:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.12);\n    border-color: var(--ks-primary-accent);\n    background: #ffffff;\n  }\n\n  .ks-custom-wcu .ks-wcu-card:hover::before {\n    opacity: 1;\n  }\n\n  .ks-custom-wcu .ks-wcu-icon-box {\n    width: 60px;\n    height: 60px;\n    border-radius: 16px;\n    background: var(--ks-primary-accent);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 22px;\n    box-shadow: 0 8px 18px -4px rgba(19, 78, 50, 0.25);\n    color: var(--ks-highlight-gold);\n    transition: transform 0.35s ease;\n  }\n\n  .ks-custom-wcu .ks-wcu-card:hover .ks-wcu-icon-box {\n    transform: scale(1.08) rotate(-3deg);\n  }\n\n  .ks-custom-wcu .ks-wcu-icon-box svg {\n    width: 30px;\n    height: 30px;\n    fill: none;\n    stroke: var(--ks-highlight-gold);\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .ks-custom-wcu .ks-wcu-card-title {\n    font-size: var(--ks-card-title-size);\n    font-weight: 800;\n    color: var(--ks-heading-color);\n    margin: 0 0 6px 0;\n  }\n\n  .ks-custom-wcu .ks-wcu-card-desc {\n    font-size: 0.88rem;\n    color: var(--ks-text-muted);\n    line-height: 1.55;\n    margin: 0 0 20px 0;\n    flex-grow: 1;\n  }\n\n  .ks-custom-wcu .ks-wcu-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 0.78rem;\n    font-weight: 800;\n    color: var(--ks-primary-accent);\n    background: var(--ks-badge-bg);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    padding: 6px 12px;\n    border-radius: 8px;\n    width: fit-content;\n  }\n\n  /* Bottom Trust Stats Bar */\n  .ks-custom-wcu .ks-wcu-bottom-bar {\n    margin-top: 48px;\n    background: var(--ks-bottom-bg);\n    border-radius: 20px;\n    padding: 28px 32px;\n    color: #ffffff;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);\n    border: 1px solid rgba(251, 191, 36, 0.3);\n  }\n\n  @media (min-width: 768px) {\n    .ks-custom-wcu .ks-wcu-bottom-bar {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n  }\n\n  .ks-custom-wcu .ks-wcu-stats-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    flex-grow: 1;\n  }\n\n  .ks-custom-wcu .ks-wcu-stat-item {\n    text-align: center;\n    border-right: 1px solid rgba(255, 255, 255, 0.15);\n    padding-right: 12px;\n  }\n\n  .ks-custom-wcu .ks-wcu-stat-item:last-child {\n    border-right: none;\n    padding-right: 0;\n  }\n\n  .ks-custom-wcu .ks-wcu-stat-number {\n    font-size: clamp(1.2rem, 3vw, 1.6rem);\n    font-weight: 900;\n    color: var(--ks-highlight-gold);\n    line-height: 1;\n    margin-bottom: 6px;\n  }\n\n  .ks-custom-wcu .ks-wcu-stat-label {\n    font-size: 0.78rem;\n    color: rgba(255, 255, 255, 0.85);\n    font-weight: 600;\n  }\n\n  .ks-custom-wcu .ks-wcu-cta-btn {\n    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);\n    color: #08281a;\n    padding: 12px 22px;\n    border-radius: 14px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    text-decoration: none;\n    font-weight: 800;\n    font-size: 0.88rem;\n    transition: all 0.3s ease;\n    box-shadow: 0 6px 18px rgba(251, 191, 36, 0.3);\n    white-space: nowrap;\n    width: fit-content;\n  }\n\n  .ks-custom-wcu .ks-wcu-cta-btn:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 22px rgba(251, 191, 36, 0.45);\n  }\n\n  .ks-custom-wcu .ks-wcu-phone-icon {\n    width: 32px;\n    height: 32px;\n    background: #08281a;\n    color: var(--ks-highlight-gold);\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n</style>\n\n<section class=\"ks-custom-wcu\">\n  <div class=\"ks-wcu-container\">\n    \n    <!-- Section Header -->\n    <div class=\"ks-wcu-header\">\n      <div class=\"ks-wcu-badge\">\n        <span class=\"ks-wcu-badge-dot\"></span>\n        <span>The Krishisathi Advantage</span>\n      </div>\n\n      <h2 class=\"ks-wcu-title\">\n        Why 50,000+ Farmers <span>Trust Us</span>\n      </h2>\n\n      <p class=\"ks-wcu-subtitle\">\n        We eliminate fake products, high market markups, and supply delays. Experience 100% authentic agricultural inputs delivered directly to your doorstep across Bihar.\n      </p>\n    </div>\n\n    <!-- 4 Core Feature Cards Grid -->\n    <div class=\"ks-wcu-grid\">\n      \n      <!-- Card 1: 100% Certified Genuine Inputs -->\n      <div class=\"ks-wcu-card\">\n        <div class=\"ks-wcu-icon-box\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n            <path d=\"M9 12l2 2 4-4\"></path>\n          </svg>\n        </div>\n        <h3 class=\"ks-wcu-card-title\">100% Certified Genuine</h3>\n        <p class=\"ks-wcu-card-desc\">\n          Directly sourced from certified seed hubs and top manufacturer warehouses with official tax invoices and batch guarantees.\n        </p>\n        <span class=\"ks-wcu-tag\">\n          ✓ Original GST Bill Guaranteed\n        </span>\n      </div>\n\n      <!-- Card 2: Doorstep Delivery in All 38 Districts -->\n      <div class=\"ks-wcu-card\">\n        <div class=\"ks-wcu-icon-box\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" rx=\"2\"></rect>\n            <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n            <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n            <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          </svg>\n        </div>\n        <h3 class=\"ks-wcu-card-title\">All 38 Districts Express</h3>\n        <p class=\"ks-wcu-card-desc\">\n          Fast doorstep delivery to every village and block across Patna, Samastipur, Muzaffarpur, Gaya, Darbhanga, and beyond within 3-5 days.\n        </p>\n        <span class=\"ks-wcu-tag\">\n          🚚 Direct Farm & Home Delivery\n        </span>\n      </div>\n\n      <!-- Card 3: Free Expert Crop Doctor Advice -->\n      <div class=\"ks-wcu-card\">\n        <div class=\"ks-wcu-icon-box\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"ks-wcu-card-title\">Free Agri-Doctor Advice</h3>\n        <p class=\"ks-wcu-card-desc\">\n          Unsure about crop diseases or dosage? Get free expert guidance from certified agricultural agronomists on call or WhatsApp.\n        </p>\n        <span class=\"ks-wcu-tag\">\n          🩺 Free Crop Health Support\n        </span>\n      </div>\n\n      <!-- Card 4: Cash On Delivery (COD) -->\n      <div class=\"ks-wcu-card\">\n        <div class=\"ks-wcu-icon-box\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"></rect>\n            <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line>\n          </svg>\n        </div>\n        <h3 class=\"ks-wcu-card-title\">Cash on Delivery (COD)</h3>\n        <p class=\"ks-wcu-card-desc\">\n          Shop risk-free! Pay only after inspect-and-receive at your farm or home. No advance payment required for peace of mind.\n        </p>\n        <span class=\"ks-wcu-tag\">\n          💵 100% Secure Payment\n        </span>\n      </div>\n\n    </div>\n\n    <!-- Bottom Trust Bar & Direct Helpline CTA -->\n    <div class=\"ks-wcu-bottom-bar\">\n      \n      <div class=\"ks-wcu-stats-grid\">\n        <div class=\"ks-wcu-stat-item\">\n          <div class=\"ks-wcu-stat-number\">50,000+</div>\n          <div class=\"ks-wcu-stat-label\">Happy Farmers</div>\n        </div>\n        <div class=\"ks-wcu-stat-item\">\n          <div class=\"ks-wcu-stat-number\">38 Districts</div>\n          <div class=\"ks-wcu-stat-label\">Full Bihar Coverage</div>\n        </div>\n        <div class=\"ks-wcu-stat-item\">\n          <div class=\"ks-wcu-stat-number\">4.9 ★</div>\n          <div class=\"ks-wcu-stat-label\">Trust Rating</div>\n        </div>\n      </div>\n\n      <a href=\"tel:78706 47015\" class=\"ks-wcu-cta-btn\">\n        <div class=\"ks-wcu-phone-icon\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n        </div>\n        <div>\n          <span style=\"font-size: 0.72rem; opacity: 0.85; display: block; font-weight: 600;\">Need Agricultural Advice?</span>\n          <span>+91 78706 47015</span>\n        </div>\n      </a>\n\n    </div>\n\n  </div>\n</section>",
