      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================================================\n     KRISHISATHI - OUR PARTNERS SECTION (CUSTOM LIQUID VERSION)\n     Modify any value below to customize colors, fonts, and sizes directly!\n     ========================================================================== */\n  .ks-custom-op {\n    /* Color Controls */\n    --ks-bg-color: #f8faf8;               /* Section background color */\n    --ks-heading-color: #08281a;          /* Main heading color */\n    --ks-text-muted: #475569;             /* Subtitle and body text color */\n    --ks-primary-accent: #134e32;         /* Brand green accent color */\n    --ks-highlight-gold: #fbbf24;         /* Gold highlight underline color */\n    --ks-card-bg: #ffffff;                /* Card background color */\n    --ks-card-border: #e2e8f0;            /* Card border color */\n    --ks-badge-bg: #ecfdf5;               /* Top badge background */\n    --ks-badge-text: #064e3b;             /* Top badge text color */\n    --ks-bottom-bg: #08281a;              /* Bottom banner background */\n    \n    /* Typography & Font Sizes */\n    --ks-title-size-mobile: 28px;         /* Heading size on Mobile */\n    --ks-title-size-desktop: 42px;        /* Heading size on Desktop */\n    --ks-subtitle-size: 16px;             /* Subtitle font size */\n    --ks-card-title-size: 18px;           /* Card title font size */\n    --ks-badge-font-size: 13px;           /* Badge font size */\n\n    /* Animation & Layout Spacing */\n    --ks-marquee-duration: 28s;           /* Marquee scroll speed (lower = faster) */\n    --ks-padding-top: 64px;               /* Section top spacing */\n    --ks-padding-bottom: 64px;            /* Section bottom spacing */\n    --ks-container-max: 1200px;           /* Max container width */\n\n    /* Base Setup */\n    padding-top: var(--ks-padding-top);\n    padding-bottom: var(--ks-padding-bottom);\n    background: var(--ks-bg-color);\n    color: var(--ks-heading-color);\n    font-family: inherit;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Container */\n  .ks-custom-op .ks-op-container {\n    max-width: var(--ks-container-max);\n    margin: 0 auto;\n    padding: 0 16px;\n    position: relative;\n    z-index: 2;\n  }\n\n  /* Section Header */\n  .ks-custom-op .ks-op-header {\n    text-align: center;\n    max-width: 780px;\n    margin: 0 auto 48px auto;\n  }\n\n  .ks-custom-op .ks-op-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--ks-badge-bg);\n    color: var(--ks-badge-text);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    padding: 6px 18px;\n    border-radius: 50px;\n    font-size: var(--ks-badge-font-size);\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-bottom: 16px;\n  }\n\n  .ks-custom-op .ks-op-badge-dot {\n    width: 8px;\n    height: 8px;\n    background-color: var(--ks-primary-accent);\n    border-radius: 50%;\n  }\n\n  .ks-custom-op .ks-op-title {\n    font-size: var(--ks-title-size-mobile);\n    font-weight: 800;\n    color: var(--ks-heading-color);\n    line-height: 1.25;\n    margin: 0 0 14px 0;\n    letter-spacing: -0.02em;\n  }\n\n  @media (min-width: 768px) {\n    .ks-custom-op .ks-op-title {\n      font-size: var(--ks-title-size-desktop);\n    }\n  }\n\n  .ks-custom-op .ks-op-title span {\n    color: var(--ks-primary-accent);\n    position: relative;\n    display: inline-block;\n  }\n\n  .ks-custom-op .ks-op-title span::after {\n    content: '';\n    position: absolute;\n    bottom: 2px;\n    left: 0;\n    width: 100%;\n    height: 6px;\n    background: var(--ks-highlight-gold);\n    opacity: 0.45;\n    z-index: -1;\n    border-radius: 4px;\n  }\n\n  .ks-custom-op .ks-op-subtitle {\n    font-size: var(--ks-subtitle-size);\n    color: var(--ks-text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* Marquee Ticker */\n  .ks-custom-op .ks-op-marquee-wrapper {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    margin-bottom: 48px;\n    padding: 18px 0;\n    background: var(--ks-card-bg);\n    border: 1px solid var(--ks-card-border);\n    border-radius: 20px;\n    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.04);\n  }\n\n  .ks-custom-op .ks-op-marquee-wrapper::before,\n  .ks-custom-op .ks-op-marquee-wrapper::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    width: 80px;\n    height: 100%;\n    z-index: 3;\n    pointer-events: none;\n  }\n\n  .ks-custom-op .ks-op-marquee-wrapper::before {\n    left: 0;\n    background: linear-gradient(90deg, var(--ks-card-bg) 0%, rgba(255, 255, 255, 0) 100%);\n  }\n\n  .ks-custom-op .ks-op-marquee-wrapper::after {\n    right: 0;\n    background: linear-gradient(-90deg, var(--ks-card-bg) 0%, rgba(255, 255, 255, 0) 100%);\n  }\n\n  .ks-custom-op .ks-op-marquee-track {\n    display: flex;\n    align-items: center;\n    gap: 48px;\n    width: max-content;\n    animation: ks-marquee-anim var(--ks-marquee-duration) linear infinite;\n  }\n\n  .ks-custom-op .ks-op-marquee-track:hover {\n    animation-play-state: paused;\n  }\n\n  @keyframes ks-marquee-anim {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .ks-custom-op .ks-op-marquee-item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 8px 20px;\n    border-radius: 12px;\n    background: #f8faf8;\n    border: 1px solid rgba(0, 0, 0, 0.05);\n    white-space: nowrap;\n    transition: all 0.3s ease;\n  }\n\n  .ks-custom-op .ks-op-marquee-item:hover {\n    background: var(--ks-badge-bg);\n    border-color: var(--ks-primary-accent);\n  }\n\n  .ks-custom-op .ks-op-marquee-item svg {\n    width: 28px;\n    height: 28px;\n    flex-shrink: 0;\n  }\n\n  .ks-custom-op .ks-op-marquee-name {\n    font-weight: 800;\n    font-size: 0.92rem;\n    color: var(--ks-heading-color);\n  }\n\n  .ks-custom-op .ks-op-marquee-category {\n    font-size: 0.74rem;\n    color: var(--ks-text-muted);\n    display: block;\n  }\n\n  /* Grid Layout */\n  .ks-custom-op .ks-op-grid {\n    display: grid;\n    grid-template-columns: repeat(1, 1fr);\n    gap: 24px;\n  }\n\n  @media (min-width: 640px) {\n    .ks-custom-op .ks-op-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (min-width: 1024px) {\n    .ks-custom-op .ks-op-grid {\n      grid-template-columns: repeat(4, 1fr);\n    }\n  }\n\n  /* Partner Cards */\n  .ks-custom-op .ks-op-card {\n    background: var(--ks-card-bg);\n    border: 1px solid var(--ks-card-border);\n    border-radius: 20px;\n    padding: 28px 22px;\n    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.04);\n    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex;\n    flex-direction: column;\n    position: relative;\n  }\n\n  .ks-custom-op .ks-op-card:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.12);\n    border-color: var(--ks-primary-accent);\n  }\n\n  .ks-custom-op .ks-op-logo-box {\n    width: 56px;\n    height: 56px;\n    border-radius: 16px;\n    background: var(--ks-primary-accent);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 20px;\n    box-shadow: 0 8px 18px -4px rgba(19, 78, 50, 0.3);\n    color: var(--ks-highlight-gold);\n  }\n\n  .ks-custom-op .ks-op-logo-box svg {\n    width: 28px;\n    height: 28px;\n    fill: none;\n    stroke: var(--ks-highlight-gold);\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .ks-custom-op .ks-op-card-title {\n    font-size: var(--ks-card-title-size);\n    font-weight: 800;\n    color: var(--ks-heading-color);\n    margin: 0 0 4px 0;\n  }\n\n  .ks-custom-op .ks-op-card-type {\n    font-size: 0.82rem;\n    font-weight: 700;\n    color: var(--ks-primary-accent);\n    margin: 0 0 12px 0;\n    display: block;\n  }\n\n  .ks-custom-op .ks-op-card-desc {\n    font-size: 0.88rem;\n    color: var(--ks-text-muted);\n    line-height: 1.55;\n    margin: 0 0 20px 0;\n    flex-grow: 1;\n  }\n\n  .ks-custom-op .ks-op-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 0.78rem;\n    font-weight: 800;\n    color: var(--ks-primary-accent);\n    background: var(--ks-badge-bg);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    padding: 6px 12px;\n    border-radius: 8px;\n    width: fit-content;\n  }\n\n  /* Bottom Trust Bar */\n  .ks-custom-op .ks-op-bottom-bar {\n    margin-top: 48px;\n    background: var(--ks-bottom-bg);\n    border-radius: 20px;\n    padding: 28px 32px;\n    color: #ffffff;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);\n    border: 1px solid rgba(251, 191, 36, 0.3);\n  }\n\n  @media (min-width: 768px) {\n    .ks-custom-op .ks-op-bottom-bar {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n  }\n\n  .ks-custom-op .ks-op-bar-content h4 {\n    font-size: 1.2rem;\n    font-weight: 800;\n    color: var(--ks-highlight-gold);\n    margin: 0 0 6px 0;\n  }\n\n  .ks-custom-op .ks-op-bar-content p {\n    font-size: 0.88rem;\n    color: rgba(255, 255, 255, 0.85);\n    margin: 0;\n    line-height: 1.5;\n  }\n\n  .ks-custom-op .ks-op-badges-flex {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  .ks-custom-op .ks-op-pill {\n    background: rgba(255, 255, 255, 0.12);\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    padding: 8px 16px;\n    border-radius: 50px;\n    font-size: 0.82rem;\n    font-weight: 700;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    white-space: nowrap;\n  }\n\n  .ks-custom-op .ks-op-pill span {\n    color: var(--ks-highlight-gold);\n  }\n</style>\n\n<section class=\"ks-custom-op\">\n  <div class=\"ks-op-container\">\n    \n    <!-- Section Header -->\n    <div class=\"ks-op-header\">\n      <div clas